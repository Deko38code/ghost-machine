# backup archives must never be committed back into the repo that backs them up.
# These are copies of the tree, not source: committing them is what grew .git to
# 11 GB and made `git gc --auto` stall the disk for 18 minutes on 2026-11-15.
snapshots/
snapshots-rsync/
backups/
Parrot-vault/
*.tar.gz
*.tar.zst

