#!/usr/bin/env bash
# secret-add — paste a secret into an env file without it ever being echoed.
#
#   secret-add NAME                 silent prompt, saves to ~/.secrets.env
#   secret-add NAME --file PATH     same, into another env file (e.g. haksterAi/.env)
#   secret-add --list [--file PATH] list names already present (no values)
#   printf '%s' "$V" | secret-add NAME --stdin
#
# The value is never printed, never in argv, never in shell history. Only a
# masked confirmation is shown: the mode prefix (sk_live_ / pk_test_ …) and the
# length. Existing names are kept unless --replace is given.
set -u

FILE="${SECRETS_FILE:-$HOME/.secrets.env}"
MODE=prompt
REPLACE=0
LIST=0
NAME=""
STYLE=auto   # export | bare, detected from the file

args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --file) FILE="${2:-}"; shift 2 ;;
    --stdin) MODE=stdin; shift ;;
    --replace) REPLACE=1; shift ;;
    --list) LIST=1; shift ;;
    -h|--help) sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) args+=("$1"); shift ;;
  esac
done

[ -e "$FILE" ] || { mkdir -p "$(dirname "$FILE")"; : > "$FILE"; chmod 600 "$FILE"; }

# Match the file's existing convention so both styles keep working when sourced.
if grep -qE '^[[:space:]]*export[[:space:]]+[A-Za-z_]' "$FILE" 2>/dev/null; then STYLE=export; fi

if [ "$LIST" = "1" ]; then
  echo "names in $FILE (values hidden):"
  sed -nE 's/^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=.*/  \2/p' "$FILE"
  exit 0
fi

NAME="${args[0]:-}"
[ -n "$NAME" ] || { echo "usage: secret-add NAME [--file PATH] [--replace] [--stdin]" >&2; exit 2; }
case "$NAME" in
  [A-Za-z_]*) ;;
  *) echo "refusing: name must start with a letter or underscore" >&2; exit 2 ;;
esac
case "$NAME" in
  *[!A-Za-z0-9_]*) echo "refusing: name may contain only letters, digits, underscore" >&2; exit 2 ;;
esac

if grep -qE "^[[:space:]]*(export[[:space:]]+)?${NAME}=" "$FILE" && [ "$REPLACE" != "1" ]; then
  echo "refusing: $NAME already exists in $FILE — pass --replace to change it" >&2
  exit 3
fi

VALUE=""
if [ "$MODE" = "stdin" ]; then
  VALUE="$(cat)"
else
  if [ ! -t 0 ]; then
    echo "no terminal on stdin — pipe the value with --stdin instead" >&2
    exit 2
  fi
  printf 'paste %s (input hidden): ' "$NAME" >&2
  IFS= read -rs VALUE
  printf '\n' >&2
fi

# Trim a trailing newline/CR from pastes; keep inner characters exactly.
VALUE="${VALUE%$'\r'}"
if [ -z "$VALUE" ]; then echo "refusing: empty value" >&2; exit 4; fi

mask() {
  local v="$1" mode=""
  case "$v" in
    sk_live_*) mode="sk_live_" ;;
    sk_test_*) mode="sk_test_" ;;
    pk_live_*) mode="pk_live_" ;;
    pk_test_*) mode="pk_test_" ;;
    rk_live_*) mode="rk_live_" ;;
    whsec_*)   mode="whsec_" ;;
    ghp_*|gho_*|ghs_*) mode="github_" ;;
  esac
  if [ -n "$mode" ]; then printf '%s… (%s chars)' "$mode" "${#v}"; else printf '(…%s chars)' "${#v}"; fi
}

# Atomic write: same directory, 600, then rename. No plaintext temp copies left.
TMP="$(mktemp "${FILE%/*}/.secret-add.XXXXXX")"
chmod 600 "$TMP"
if grep -qE "^[[:space:]]*(export[[:space:]]+)?${NAME}=" "$FILE"; then
  awk -v n="$NAME" -v out="$TMP" -v style="$STYLE" -v val="$VALUE" '
    BEGIN { done = 0 }
    {
      line = $0
      if (line ~ ("^[[:space:]]*(export[[:space:]]+)?" n "=")) {
        print (style == "export" ? "export " : "") n "=" val
        done = 1
      } else { print line }
    }
    END { if (!done) print (style == "export" ? "export " : "") n "=" val }
  ' "$FILE" > "$TMP"
else
  cp -p "$FILE" "$TMP" 2>/dev/null || true
  printf '%s%s=%s\n' "$([ "$STYLE" = export ] && echo 'export ')" "$NAME" "$VALUE" >> "$TMP"
fi
chmod 600 "$TMP"
mv -f "$TMP" "$FILE"
chmod 600 "$FILE"

echo "saved $NAME -> $FILE  $(mask "$VALUE")  mode 600"
echo "load it with:  set -a; . \"$FILE\"; set +a"
