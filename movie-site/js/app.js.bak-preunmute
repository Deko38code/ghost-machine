  // Update player title when movie data arrives asynchronously
  function updatePlayerTitle() {
    if (!playerTitle || !currentMovieData) return;
    let titleText = currentMovieData.title || currentMovieData.name || 'Now Playing';
    if (currentIsTV) {
      const s = currentSeason || 1;
      const e = currentEpisode || 1;
