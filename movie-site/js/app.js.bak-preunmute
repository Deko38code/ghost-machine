    function normalizeMaPlaylistItems(items, host, mac) {
      const seen = new Set();
      const seenName = new Set();
      const normalized = (items || []).map((item, idx) => {
        const rawType = String(item.type || item.category || '').toLowerCase();
        const type = rawType.includes('series') ? 'series' : (rawType.includes('vod') || rawType.includes('movie') ? 'movies' : 'live');
        const cmd = String(item.cmd || item.url || item.stream_url || item.streamUrl || '').trim();
        const url = String(item.url || item.stream_url || item.streamUrl || item.cmd || '').trim();
        const id = String(item.id || item.channel_id || item.number || item.ch_number || '').trim();
        const name = String(item.name || item.title || `Channel ${idx + 1}`).replace(/[\x00-\x1f]/g, '').trim();
        if (/^(#+|=+|-{4,})/.test(name) || /^(#+|=+).*(#+|=+)$/i.test(name)) return null;
        const group = item.group || item.genreName || item.genre || '';
        const key = `${type}|${id || cmd || url || name.toLowerCase()}|${group}`;
        const nameKey = `${type}|${name.toLowerCase()}`;
        if (maDedupeInput?.checked !== false) {
          if (seen.has(key)) return null;
          // Also dedupe by name within same type (catches same channel with different group/id)
          if (seenName.has(nameKey) && type === 'live') return null;
          seen.add(key);
          seenName.add(nameKey);
        }
        return {
          ...item,
          id,
          name,
          url,
          cmd,
          type,
          host: item.host || host,
          mac: item.mac || mac,
          number: item.number || item.ch_number || '',
          logo: maLogoCardsInput?.checked === false ? '' : normalizeMaLogoUrl(item.logo || item.icon || '', host),
          group,
          genreName: item.genreName || item.group || item.genre || '',
        };
      }).filter(item => item && (item.url || item.cmd || item.vodCategoryId));
      return maUsFirstInput?.checked === false ? normalized : sortMaPlaylistUSFirst(normalized);
    }

    function maUSChannelScore(item) {
      const groupText = String([item.group || '', item.genreName || '', item.country || '', item.category || ''].join(' ')).toLowerCase();
      const nameText = String(item.name || '').toLowerCase();
      if (/\b(us|usa|u\.s\.a|united states)\b/.test(groupText)) return 0;
      if (!groupText.trim() && /\b(us|usa|u\.s\.a|united states)\b/.test(nameText)) return 0;
      const text = `${groupText} ${nameText}`;
      if (/\b(abc|cbs|nbc|fox|pbs|cw|espn|nfl|nba|mlb|nhl|usa network|cnn|msnbc|cnbc|fox news|hbo|showtime|starz|cinemax|tnt|tbs|fx|fxx|amc|a\&e|history|discovery|tlc|food network|hallmark|bravo|paramount|nickelodeon|cartoon network|adult swim|freeform|syfy|weather channel)\b/.test(text)) return 1;
      if (/\b(canada|uk|united kingdom|latino|mexico|spain|india|arabic|france|germany|italy|portugal|brazil)\b/.test(text)) return 3;
      return 2;
    }

    function sortMaPlaylistUSFirst(items) {
      return [...items].sort((a, b) => {
        const scoreDiff = maUSChannelScore(a) - maUSChannelScore(b);
        if (scoreDiff) return scoreDiff;
        const numberDiff = (parseInt(a.number || '999999', 10) || 999999) - (parseInt(b.number || '999999', 10) || 999999);
        if (numberDiff) return numberDiff;
        return String(a.name || '').localeCompare(String(b.name || ''));
      });
    }
