  // ── Client-side movie-db cache for instant search ──
  let _localMovieDb = null;
  let _localMovieDbPromise = null;
  function getLocalMovieDb() {
    if (_localMovieDb) return Promise.resolve(_localMovieDb);
    if (_localMovieDbPromise) return _localMovieDbPromise;
    _localMovieDbPromise = fetch('/api/movie-db?limit=9999')
      .then(r => r.ok ? r.json() : null)
      .then(d => { _localMovieDb = Array.isArray(d?.entries) ? d.entries : []; return _localMovieDb; })
      .catch(() => { _localMovieDb = []; return _localMovieDb; });
    return _localMovieDbPromise;
  }
  if (typeof requestIdleCallback !== 'undefined') requestIdleCallback(() => getLocalMovieDb());
  else setTimeout(() => getLocalMovieDb(), 1000);

  let activeSearchRequest = 0;

  function renderSearchResults(results, exactQ) {
    const sortedResults = sortSearchResultsByQuery(results, exactQ);
    searchGrid.innerHTML = '';
    sortedResults.slice(0, 120).forEach(m => searchGrid.appendChild(movieCard(m, true)));
    searchEmpty.style.display = results.length ? 'none' : '';
  }

  async function doSearch(query) {
    query = normalizeSearchQuery(query);
    if (!query) return;
    const requestId = ++activeSearchRequest;
    showSearchResultsPage();
    searchTitle.textContent = `🔍 Results for "${query}"`;
    showSkeletons(searchGrid, 12);
    const q = query.toLowerCase();
    const exactQ = normalizeClientSearchText(query);
    const compactQ = compactSearchTerms(query);
    const results = [];
    const isStale = () => requestId !== activeSearchRequest || normalizeSearchQuery(searchInput?.value || query) !== query;

    // 1. Local movie DB — searched in-memory for instant results
    try {
      const dbEntries = await getLocalMovieDb();
      if (isStale()) return;
      if (dbEntries.length) {
        const dbResults = dbEntries
          .filter(m => {
            const title = m?.title || m?.name || '';
            return searchResultMatchesQuery(query, m) || compactSearchTerms(title) === compactQ || searchDotMatch(query, title);
          })
          .sort((a, b) => {
            const at = normalizeClientSearchText(a.title);
            const bt = normalizeClientSearchText(b.title);
            if (at === exactQ && bt !== exactQ) return -1;
            if (bt === exactQ && at !== exactQ) return 1;
            if (at.startsWith(exactQ) && !bt.startsWith(exactQ)) return -1;
            if (bt.startsWith(exactQ) && !at.startsWith(exactQ)) return 1;
            return parseInt(b.year||0) - parseInt(a.year||0);
          });
        if (dbResults.length) {
          addSearchResults(results, dbResults, normalizeBankSearchResult);
          if (!isStale()) renderSearchResults(results, exactQ);
          return;
        }
      }
    } catch {}

    // Render local results immediately — don't wait for TMDB
    if (results.length && !isStale()) renderSearchResults(results, exactQ);

    // 2. AI search
    if (typeof AISearch !== 'undefined') {
      try {
        if (isStale()) return;
        addSearchResults(results, AISearch.search(query));
      } catch {}
    }

    // 3. TMDB
    if (CONFIG.tmdb.apiKey) {
      try {
        if (isStale()) return;
        const data = await tmdbApi.search(query);
        if (isStale()) return;
        addSearchResults(results, (data.results || []).filter(m => searchResultMatchesQuery(query, m)));
      } catch {}
    }

    // 4. Curated fallback
    const fallback = CURATED_FALLBACK.filter(m => searchResultMatchesQuery(query, m) || compactSearchTerms(m.title) === compactQ);
    addSearchResults(results, fallback, m => ({
      ...m,
      poster_path: m.poster,
      vote_average: m.rating,
      release_date: String(m.year)
    }));

    // 5. Outside-bank lookup only if still no results
    if (!results.length) {
      if (isStale()) return;
      const outsideBank = await lookupTitleOutsideBank(query);
      if (isStale()) return;
      if (outsideBank.length) {
        const exactOutside = outsideBank.find(m => {
          const title = normalizeClientSearchText(m?.title || m?.name);
          return title === q || title.startsWith(q) || q.startsWith(title);
        });
        addSearchResults(results, exactOutside ? [exactOutside] : outsideBank);
      }
    }

    if (isStale()) return;
    const filtered = results.filter(m =>
      searchResultMatchesQuery(query, m) ||
      normalizeClientSearchText(m?.title || m?.name).includes(exactQ) ||
      compactSearchTerms(m?.title || m?.name) === compactQ ||
      searchDotMatch(query, m?.title || m?.name)
    );
    renderSearchResults(filtered.length ? filtered : results, exactQ);
  }

  function wireLiveMovieSearch(input, run, delay = 220) {
    if (!input || input.dataset.liveMovieSearch === '1') return;
    input.dataset.liveMovieSearch = '1';
    let timer = null;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      const query = normalizeSearchQuery(input.value);
      if (query.length < 2) return;
      timer = setTimeout(() => run(query), delay);
    });
  }

