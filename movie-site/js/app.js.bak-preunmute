  function appendCard(row, card, movieId) {
    const rowId = row.id || row.parentElement?.id || 'unknown';
    if (!movieId) { row.appendChild(card); return; }
    if (!_renderedIdsPerRow.has(rowId)) _renderedIdsPerRow.set(rowId, new Set());
    const seen = _renderedIdsPerRow.get(rowId);
    if (seen.has(movieId)) return; // SKIP dup in this row
    seen.add(movieId);
    row.appendChild(card);
