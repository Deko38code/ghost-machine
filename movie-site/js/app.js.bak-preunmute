      maTerminal.writeln('\x1b[90mClick ▶ Start to launch macattack.py\x1b[0m\r\n');

      // Resize observer
      const resizeObs = new ResizeObserver(() => {
        try { maTermFitAddon.fit(); } catch(e) {}
        // Send resize to pty
        if (maTerminal && maTermWs && maTermWs.readyState === 1) {
          maTermWs.send(JSON.stringify({ type: 'resize', cols: maTerminal.cols, rows: maTerminal.rows }));
