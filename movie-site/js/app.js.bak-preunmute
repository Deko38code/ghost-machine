      video._hls.destroy();
      video._hls = null;
    }
    playerVideoWrap.innerHTML = '';
    playerElement = null;
    // ── PERFORMANCE: Restore background polling paused during playback ──
    if (window._pausedBackgroudPolls) {
      const p = window._pausedBackgroudPolls;
      if (p.status) macAttackStatusPollId = p.status;
      if (p.log) macAttackLogPollId = p.log;
      if (p.hourly && typeof hourlyCheckInterval !== 'undefined') hourlyCheckInterval = p.hourly;
