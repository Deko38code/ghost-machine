    document.querySelectorAll('#macattack-eye-group-right ellipse[fill^="url(#eyeGlow"]').forEach(el => {
      el.setAttribute('fill', state === 'green' ? 'url(#eyeGlowRightGreen)' : 'url(#eyeGlowRight)');
