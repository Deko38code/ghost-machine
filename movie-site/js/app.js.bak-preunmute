  function formatTime(s) {
    if (!isFinite(s) || s < 0) return 'LIVE';
    const h = Math.floor(s/3600);
    const m = Math.floor((s%3600)/60);
    const sec = Math.floor(s%60);
    return h > 0 ? `${h}:${String(m).padStart(2,'0')}:${String(sec).padStart(2,'0')}` : `${m}:${String(sec).padStart(2,'0')}`;
  }

  function forceBestHlsQuality(hls, label = '') {
    if (!hls || !Array.isArray(hls.levels) || !hls.levels.length) return;
    const bestLevel = hls.levels.reduce((bestIdx, level, idx, levels) => {
      const best = levels[bestIdx] || {};
      const bestHeight = best.height || 0;
      const bestBitrate = best.bitrate || 0;
      const height = level.height || 0;
      const bitrate = level.bitrate || 0;
      if (height > bestHeight) return idx;
      if (height === bestHeight && bitrate > bestBitrate) return idx;
      return bestIdx;
    }, 0);
    try {
      hls.capLevelToPlayerSize = false;
      hls.autoLevelCapping = bestLevel;
      hls.startLevel = bestLevel;
      hls.currentLevel = bestLevel;
      hls.nextLevel = bestLevel;
      hls.loadLevel = bestLevel;
      if (label) dbgLog(`Quality locked to highest level ${bestLevel}${hls.levels[bestLevel]?.height ? ` (${hls.levels[bestLevel].height}p)` : ''}`, '#0ff');
    } catch {}
  }

