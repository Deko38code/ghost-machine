    document.body.classList.remove('player-active');
    // Reconnect MutationObserver after playback ends
    if (window._stalkerMO) {
      window._stalkerMO.observe(document.body, { attributes: true, subtree: true, attributeFilter: ['style'] });
    }
    // Restore background page visibility (was display:none during playback)
    const pageContent = document.getElementById('page-content') || document.querySelector('main') || document.querySelector('.page-content');
    if (pageContent) pageContent.style.display = '';
    document.querySelectorAll('.content-section, .movie-grid, .movie-row, section, .hero-content, nav, footer').forEach(el => {
