            if (dot) { dot.style.background = '#fa0'; dot.style.boxShadow = '0 0 6px #fa0'; }
            if (pauseBtn) pauseBtn.textContent = '▶';
          }
          const name = (data.information?.category?.meta?.filename || data.information?.category?.meta?.title || '').substring(0, 30);
          const time = data.time ? formatTime(data.time) : '0:00';
          const duration = data.length ? formatTime(data.length) : '';
          if (txt) txt.textContent = name ? `VLC: ${name} ${time}${duration ? '/' + duration : ''}` : `VLC ${data.state}`;
