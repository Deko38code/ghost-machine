    if (serveoTunnelPollId) { clearInterval(serveoTunnelPollId); serveoTunnelPollId = null; }
    window._pausedBackgroudPolls = { status: _prePlaybackStatusPoll, log: _prePlaybackLogPoll, hourly: _prePlaybackHourly, tunnel: _prePlaybackTunnel };

    // Fetch movie data in parallel — don't block the spinner
    const dataPromise = (!currentMovieData || currentMovieData.id !== movieId)
      ? fetchMovieData(movieId, isTV).then(result => {
