    function connectMaTermWs() {
      const protocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
      const wsUrl = `${protocol}//${location.host}/ws/terminal`;
      maTermWs = new WebSocket(wsUrl);
      const startBtn = document.getElementById('ma-term-start-btn');
      const stopBtn = document.getElementById('ma-term-stop-btn');

      maTermWs.onopen = () => {
        maTermConnected = true;
        if (startBtn) startBtn.style.display = 'none';
        if (stopBtn) stopBtn.style.display = '';
        // Spawn macattack.py
        maTermWs.send(JSON.stringify({
          type: 'start',
          cmd: 'python3',
          args: ['/home/ghost/macattack-linux/macattack.py'],
          cwd: '/home/ghost/macattack-linux',
          cols: maTerminal.cols || 80,
          rows: maTerminal.rows || 24
        }));
      };

      maTermWs.onmessage = (evt) => {
        try {
          const data = JSON.parse(evt.data);
          if (data.type === 'output' && maTerminal) {
            maTerminal.write(data.data);
          } else if (data.type === 'exit' && maTerminal) {
            maTerminal.writeln(`\r\n\x1b[1;33mProcess exited (code ${data.code})\x1b[0m`);
            maTermConnected = false;
            if (startBtn) startBtn.style.display = '';
            if (stopBtn) stopBtn.style.display = 'none';
          }
        } catch(e) {}
      };

      maTermWs.onerror = () => {
        maTerminal.writeln('\r\n\x1b[1;31m✗ Connection error\x1b[0m');
      };

      maTermWs.onclose = () => {
        maTermConnected = false;
        if (startBtn) startBtn.style.display = '';
        if (stopBtn) stopBtn.style.display = 'none';
        maTerminal.writeln('\r\n\x1b[1;31m■ Disconnected\x1b[0m');
      };
    }

