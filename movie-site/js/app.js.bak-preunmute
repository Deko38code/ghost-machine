    }
    playerTitle.textContent = titleText;
  }

  // ── PARALLEL SOURCE RACING ──
  // Probe top sources with lightweight fetch() to find fastest responder,
  // then load ONLY that source in a single iframe. No bandwidth competition.
  let _raceController = null;
  function raceSources(movieId) {
    // Cancel any previous race
    if (_raceController) _raceController.cancelled = true;
    const ctrl = { cancelled: false };
    _raceController = ctrl;

    const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent) || window.innerWidth <= 768;

    // ── Mobile-optimized: fewer probes, shorter timeouts ──
    // Desktop: 7 candidates, 1.5s probe timeout, 2s fallback
    // Mobile: 3 candidates, 800ms probe timeout, 1.2s fallback — saves bandwidth + time
    const maxCandidates = isMobile ? 3 : 7;
    const probeTimeout = isMobile ? 800 : 1500;
    const fallbackTimeout = isMobile ? 1200 : 2000;

    // Pick racable sources (skip goojara/playmogo/lookmovie/portal/direct)
    const racable = SOURCE_ORDER.filter(k => {
      const s = STREAM_SOURCES[k];
      return s && !s.goojara && !s.playmogo && !s.portal && k !== 'lookmovie' && k !== 'direct' && k !== 'portal';
    });
    const candidates = racable.slice(0, maxCandidates);
    let settled = false;

    showPlayerSpinner(isMobile ? '💀 Loading...' : '💀 Probing sources...');

    // Build URL map for candidates
    const urlMap = {};
    candidates.forEach(sourceKey => {
      const url = getSourceUrl(sourceKey, movieId, currentSeason, currentEpisode);
      if (url) urlMap[sourceKey] = url;
    });

    // ── Preconnect: DNS + TCP hint for top 2 sources on mobile ──
    // This gives the browser a head start before the iframe loads
    if (isMobile) {
      const preconnectSources = Object.keys(urlMap).slice(0, 2);
      preconnectSources.forEach(key => {
        try {
          const url = new URL(urlMap[key]);
          const link = document.createElement('link');
          link.rel = 'preconnect';
          link.href = url.origin;
          document.head.appendChild(link);
          // Clean up after 5s
          setTimeout(() => { try { document.head.removeChild(link); } catch {} }, 5000);
        } catch {}
      });
    }

    // Race lightweight HEAD probes — fastest responder wins
    const probes = Object.keys(urlMap).map(sourceKey => {
      return fetch(urlMap[sourceKey], { method: 'HEAD', mode: 'no-cors', signal: AbortSignal.timeout(probeTimeout) })
        .then(() => ({ sourceKey, time: performance.now() }))
        .catch(() => null);
    });

    // ── Mobile eager-load: don't wait for all probes ──
    // On mobile, load the first source immediately after a short grace period
    // if no probe has resolved yet. This cuts 1-2s of waiting on slow connections.
    let eagerLoaded = false;
    if (isMobile) {
      setTimeout(() => {
        if (ctrl.cancelled || settled || eagerLoaded) return;
        // No probe resolved fast enough — load top candidate now
        const first = Object.keys(urlMap)[0];
        if (first) {
          settled = true;
          eagerLoaded = true;
          currentSource = first;
          console.log('[CineVault] Mobile eager-load: skipping probe, loading', first);
          loadPlayerSource(movieId, first);
        }
      }, 600);
    }

    Promise.race(probes.filter(p => p)).then(result => {
      if (ctrl.cancelled || settled) return;
      settled = true;
      if (result && result.sourceKey) {
        currentSource = result.sourceKey;
        showPlayerSpinner(`💀 Loading ${STREAM_SOURCES[result.sourceKey]?.name || result.sourceKey}...`);
        loadPlayerSource(movieId, result.sourceKey);
      } else {
        // All probes failed — try first source via iframe fallback
        const first = Object.keys(urlMap)[0];
        if (first) {
          currentSource = first;
          loadPlayerSource(movieId, first);
        } else {
          showPlayerError();
        }
      }
    });

    // Fallback: if nothing resolves in time, try first candidate
    sourceTimeout = setTimeout(() => {
      if (ctrl.cancelled || settled) return;
      settled = true;
      const first = Object.keys(urlMap)[0];
      if (first) {
        currentSource = first;
        console.warn('[CineVault] All probes timed out, falling back to', first);
        loadPlayerSource(movieId, first);
      } else {
        loadPlayerSource(movieId, currentSource || 'vidsrcpm');
      }
    }, fallbackTimeout);
  }

  function loadPlayerSource(movieId, sourceKey) {
    playerVideoWrap.innerHTML = '';
    setPlayerTimePending();
    if (sourceTimeout) clearTimeout(sourceTimeout);

    const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent) || window.innerWidth <= 768;

    // ── Goojara requires async search → episode lookup ──
    const src = typeof STREAM_SOURCES !== 'undefined' ? STREAM_SOURCES[sourceKey] : null;
    if (src && src.goojara) {
      loadGoojaraSource(movieId);
      return;
    }

    // ── Playmogo uses Direct URL path (CF-protected, short codes) ──
    if (src && src.playmogo) {
      const pmUrl = getSourceUrl('playmogo', movieId, currentSeason, currentEpisode);
      if (pmUrl) {
        loadDirectUrl(pmUrl);
        $$('.source-tab').forEach(t => t.classList.toggle('active', t.dataset.source === 'playmogo'));
        showToast('🎬 Loading Playmogo...');
      } else {
        // No short code mapped → suggest Direct URL tab
        showToast('🎬 No Playmogo code for this title — use 🔗 Direct URL tab');
        tryNextSource(movieId);
      }
      return;
    }

    // ── Direct URL mode ──
    if (sourceKey === 'direct') {
      const urlBar = document.getElementById('direct-url-bar');
      if (urlBar) urlBar.style.display = 'flex';
      return;
    }

    // ── Portal fallback waterfall ──
    if (sourceKey === 'portal') {
      loadPortalFallback(movieId);
      return;
    }

    // ── PORTAL FALLBACK WATERFALL ──
    // When all embed sources fail, try portal hits to load a live TV stream
    async function loadPortalFallback(movieId) {
      showPlayerSpinner('💀 Loading portal hits...');
      setSkullEyes('scan');
      $$('.source-tab').forEach(t => t.classList.toggle('active', t.dataset.source === 'portal'));
      
      try {
        const res = await fetch('/api/portal-hits?status=live');
        const data = await res.json();
        const hits = Array.isArray(data) ? data : (data.hits || []);
        
        if (hits.length === 0) {
          showPlayerSpinner('💀 No portal hits found — run portal-scan first');
          setSkullEyes('error');
          showToast('💀 No working portals — try scanning first', 'error');
          return;
        }

        // Try each hit as waterfall
        for (let i = 0; i < Math.min(hits.length, 5); i++) {
          const hit = hits[i];
          showPlayerSpinner(`💀 Trying portal ${i+1}/${Math.min(hits.length,5)}: ${hit.channels}ch...`);
          setSkullEyes('yellow');
          
          try {
            const chRes = await fetch(`/api/stalker-channels?url=${encodeURIComponent(hit.portal)}&mac=${encodeURIComponent(hit.mac)}&proxy=server`, {
              signal: AbortSignal.timeout(15000),
            });
            const chData = await chRes.json();
            
            if (chData.channels && chData.channels.length > 0) {
              // Found live channels! Load the first playable one
              const playable = chData.channels.find(c => c.url);
              if (playable && playable.url) {
                playerVideoWrap.innerHTML = '';
                const video = document.createElement('video');
                video.src = playable.url;
                video.autoplay = true;
                video.muted = true;
                video.playsInline = true;
                video.setAttribute('playsinline', '');
                video.setAttribute('webkit-playsinline', '');
                video.setAttribute('x5-video-player-type', 'h5');
                video.setAttribute('x5-video-player-fullscreen', 'false');
                video.style.cssText = 'width:100%;height:100%;background:#000';
                playerVideoWrap.appendChild(video);
                hidePlayerSpinner();
                setSkullEyes('green');
                playHitSound();
                const titleEl = document.getElementById('player-title-text');
                if (titleEl) titleEl.textContent = playable.name || 'Portal Stream';
                showToast(`💀 Portal LIVE: ${hit.channels}ch from ${playable.name}`, 'success');
                return;
              }
            }
          } catch { /* try next */ }
        }
        
        // All portal hits failed
        showPlayerSpinner('💀 All portal hits failed');
        setSkullEyes('error');
        showToast('💀 Portal waterfall exhausted — no playable streams', 'error');
      } catch {
        showPlayerSpinner('💀 Portal fetch error');
        setSkullEyes('error');
      }
    }

    // ── LookMovie opens in new tab (not an embed site) ──
    if (sourceKey === 'lookmovie') {
      const lmUrl = getSourceUrl('lookmovie', movieId, currentSeason, currentEpisode);
      if (lmUrl) {
        window.open(lmUrl, '_blank');
        showToast('👁️ Opened LookMovie in new tab');
      }
      return;
    }

    let url = getSourceUrl(sourceKey, movieId, currentSeason, currentEpisode);
    if (!url) {
      tryNextSource(movieId);
      return;
    }

    // 2026-05: Load embed URLs directly in iframe (no proxy).
    // The embed proxy was breaking video players by rewriting URLs inside
    // Cloudflare-protected pages. Iframes load cross-origin fine without CORS.
    // The proxy is still available at /api/embed-proxy for other uses.

    $$('.source-tab').forEach(t => t.classList.toggle('active', t.dataset.source === sourceKey));

    const iframe = preparePlayerIframe(document.createElement('iframe'));
    iframe.src = url;
    iframe.setAttribute('loading', 'eager');   // Never lazy-load the player iframe
    iframe.setAttribute('importance', 'high');  // Priority hint for browser scheduling
    iframe.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture; popups; forms; same-origin';
    iframe.allowFullscreen = true;
    iframe.setAttribute('referrerpolicy', 'no-referrer');
    // Movie embeds need normal iframe semantics for player bootstrap redirects.
    iframe.removeAttribute('sandbox');
    iframe.style.cssText = 'width:100%;height:100%;border:none;outline:none;background:#000;';

    let loaded = false;
    iframe.onload = () => {
      loaded = true;
      if (sourceTimeout) clearTimeout(sourceTimeout);
      embedSeekOffset = 0;
      const title = currentMovieData?.title || currentMovieData?.name || heroMovie?.title || 'Now Playing';
      setSkullConnected(title);
      if (playerTitle) playerTitle.textContent = title;
      startEmbedTimeDisplay();
      // Log the watch
      if (typeof MovieLogs !== 'undefined') {
        MovieLogs.add('watch', title, movieId, {
          season: currentSeason,
          episode: currentEpisode,
          source: sourceKey,
        });
      }
    };
    iframe.onerror = () => {
      if (!loaded) {
        setSkullEyes('red');
        tryNextSource(movieId);
      }
    };

    // ── Mobile-optimized source timeout: fail faster on slow connections ──
    const sourceLoadTimeout = isMobile ? 3000 : 5000;
    sourceTimeout = setTimeout(() => {
      if (!loaded) {
        console.warn(`[CineVault] Source ${sourceKey} timed out, trying next...`);
        setSkullEyes('red');
        tryNextSource(movieId);
      }
    }, sourceLoadTimeout);

      playerVideoWrap.appendChild(iframe);
      playerElement = iframe;
      // Show unmute + tap-to-play prompt for iframe embeds — browsers like FireDragon
      // block autoplay aggressively, video sits frozen until user interacts.
      // The overlay stays until clicked (no auto-hide) so the user always sees it.
      if (playerElement.tagName === 'IFRAME') {
        const unmuteOverlay = document.createElement('div');
        unmuteOverlay.id = 'unmute-overlay';
        unmuteOverlay.style.cssText = 'position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.5);cursor:pointer;z-index:4;transition:opacity 0.3s ease;pointer-events:auto;';
        unmuteOverlay.innerHTML = '<div style="background:rgba(229,9,20,0.95);color:#fff;padding:16px 32px;border-radius:14px;font-size:1.1rem;font-weight:700;display:flex;align-items:center;gap:12px;box-shadow:0 4px 24px rgba(0,0,0,0.6);pointer-events:none;animation:pulse-btn 1.5s ease-in-out infinite;">▶️ Tap to Play 🔊</div>';
        unmuteOverlay.addEventListener('click', () => {
          // Focus iframe for user-gesture audio + play unlock, then unmute
          try { playerElement.focus(); } catch {}
          try { playerElement.contentWindow?.postMessage({ type: 'unmute' }, '*'); } catch {}
          try { playerElement.contentWindow?.postMessage({ type: 'play' }, '*'); } catch {}
          try { playerElement.contentWindow?.postMessage({ method: 'play' }, '*'); } catch {}
          setPlayerVolume(lastVolume || 80);
          unmuteOverlay.style.opacity = '0';
          setTimeout(() => { if (unmuteOverlay.parentNode) unmuteOverlay.remove(); }, 300);
        });
        // Also respond to keyboard/remote Enter for Fire Stick
        unmuteOverlay.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            unmuteOverlay.click();
          }
        });
        playerVideoWrap.appendChild(unmuteOverlay);
        // Auto-hide after 15 seconds (was 8 — give more time on slow connections)
        // If still there, fade out but DON'T remove — user can still tap
        setTimeout(() => {
          const ov = document.getElementById('unmute-overlay');
          if (ov) {
            ov.style.opacity = '0.6';
            // Keep it clickable even when dimmed
          }
        }, 15000);
      }
      setPlayerVolume(playerVolSlider ? playerVolSlider.value : lastVolume);
      startControlsAutoHide();
    }

  // ── GOOJARA SOURCE LOADER ──
  // Goojara uses short codes (eLRN11), not IMDB IDs. Must search → find show → get episode page.
  async function loadGoojaraSource(movieId) {
    const title = currentMovieData?.title || currentMovieData?.name || '';
    const isTV = currentIsTV;
    showPlayerSpinner('🟢 Searching Goojara...');
    setSkullEyes('red');

    $$('.source-tab').forEach(t => t.classList.toggle('active', t.dataset.source === 'goojara'));

    try {
      if (typeof GoojaraScraper === 'undefined') {
        toast('🟢 Goojara scraper not loaded', 'error');
        tryNextSource(movieId);
        return;
      }

      // Search for the show on Goojara
      const searchType = isTV ? 'tv' : 'movie';
      const result = await GoojaraScraper.search(title, searchType);
      if (!result || !result.slug) {
        toast('🟢 Not found on Goojara', 'warning');
        tryNextSource(movieId);
        return;
      }

      // For TV shows, fetch episode page
      let embedUrl;
      if (isTV && currentSeason && currentEpisode) {
        const seriesInfo = await GoojaraScraper.getSeriesInfo(result.slug);
        if (!seriesInfo) {
          toast('🟢 Could not load series info', 'warning');
          tryNextSource(movieId);
          return;
        }
        // Use season query param directly on the slug
        const seasonUrl = `${GoojaraScraper.BASE}/${result.slug}?s=${currentSeason}`;
        const episodeHtml = await GoojaraScraper._fetch(seasonUrl);
        if (!episodeHtml) {
          toast('🟢 Could not load season page', 'warning');
          tryNextSource(movieId);
          return;
        }
        // Extract episode links — each has a short code like /eLRN11
        const epRegex = new RegExp(`href="(https?://[^"]+/[a-zA-Z0-9]{5,8})"[^>]*title="[^"]*[Ss]0?${currentSeason}[Ee]0?${currentEpisode}[^"]*"`, 'i');
        const epMatch = episodeHtml.match(epRegex);
        if (epMatch) {
          embedUrl = epMatch[1];
        } else {
          // Fallback: grab all episode links and pick by index
          const allEps = [];
          const epRx = /href="(https?:\/\/[^"]+\/[a-zA-Z0-9]{5,8})"[^>]*title="([^"]*\(S?\d+\.?\s*E?\d+[^)]*\))"/gi;
          let m;
          while ((m = epRx.exec(episodeHtml)) !== null) {
            allEps.push({ url: m[1], title: m[2] });
          }
          // Try to match by episode number
          const epNum = parseInt(currentEpisode);
          if (allEps.length >= epNum) {
            embedUrl = allEps[epNum - 1].url;
          } else if (allEps.length > 0) {
            embedUrl = allEps[0].url;
          }
        }
      } else {
        // For movies, the slug IS the page
        embedUrl = `${GoojaraScraper.BASE}/${result.slug}`;
      }

      if (!embedUrl) {
        toast('🟢 Episode not found on Goojara', 'warning');
        tryNextSource(movieId);
        return;
      }

      // Route through our proxy for CORS
      const finalUrl = proxyUrl(embedUrl);
      showPlayerSpinner('🟢 Loading Goojara...');

      const iframe = preparePlayerIframe(document.createElement('iframe'));
      iframe.src = finalUrl;
      iframe.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture; popups; forms; same-origin';
      iframe.allowFullscreen = true;
      iframe.setAttribute('referrerpolicy', 'no-referrer');
      iframe.removeAttribute('sandbox');
      iframe.style.cssText = 'width:100%;height:100%;border:none;outline:none;background:#000;';

      let loaded = false;
      iframe.onload = () => {
        loaded = true;
        if (sourceTimeout) clearTimeout(sourceTimeout);
        embedSeekOffset = 0;
        const displayName = currentMovieData?.title || currentMovieData?.name || 'Now Playing';
        setSkullConnected(displayName);
        if (playerTitle) playerTitle.textContent = displayName + ' 🟢 Goojara';
        if (typeof MovieLogs !== 'undefined') {
          MovieLogs.add('watch', displayName, movieId, {
            season: currentSeason,
            episode: currentEpisode,
            source: 'goojara',
          });
        }
      };
      iframe.onerror = () => {
        if (!loaded) { setSkullEyes('red'); tryNextSource(movieId); }
      };

      sourceTimeout = setTimeout(() => {
        if (!loaded) {
          console.warn('[CineVault] Goojara source timed out, trying next...');
          setSkullEyes('red');
          tryNextSource(movieId);
        }
      }, 12000);

      playerVideoWrap.appendChild(iframe);
      playerElement = iframe;
      // Tap-to-play overlay for Goojara (same autoplay block issue as other embeds)
      if (playerElement.tagName === 'IFRAME') {
        const tapOverlay = document.createElement('div');
        tapOverlay.id = 'unmute-overlay';
