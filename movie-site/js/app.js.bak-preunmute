  async function init() {
    applyTheme(store.getTheme());
    bindEvents();

    // ── Global video stall recovery: auto-retry on network errors ──
    document.addEventListener('error', (e) => {
      const v = e.target;
      if (v && v.tagName === 'VIDEO' && v.src) {
        console.warn('[CineVault] Video error, retrying in 2s...', v.error?.code, v.src);
        setTimeout(() => {
          if (!v.paused && v.networkState === v.NETWORK_EMPTY) {
            v.load();
            v.play().catch(() => {});
          }
        }, 2000);
      }
    }, true); // capture phase to catch all video errors

    // ── Respect prefers-reduced-motion: pause all decorative videos ──
    const reduceMotionMQ = window.matchMedia('(prefers-reduced-motion: reduce)');
    function applyReduceMotion(prefersReduced) {
      document.querySelectorAll('.skull-spinner-video, .macattack-skull-video, .brand-icon video, .ma-player-intro-video').forEach(v => {
        if (prefersReduced) v.pause(); else v.play().catch(() => {});
      });
    }
    applyReduceMotion(reduceMotionMQ.matches);
    reduceMotionMQ.addEventListener('change', e => applyReduceMotion(e.matches));

    // ═══════════════════════════════════════════════
