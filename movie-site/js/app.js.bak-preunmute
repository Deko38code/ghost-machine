  function setupLazySiteVideos() {
    const videos = $$('.skull-spinner-video, .macattack-skull-video, .ma-player-intro-video, .brand-icon video, #wd-status-bar video, #wd-run-now video');
    if (!videos.length) return;
    const managedVideos = [];

    videos.forEach(video => {
      if (video.dataset.lazyManaged === 'true') return;
      video.dataset.lazyManaged = 'true';
      managedVideos.push(video);
      // Player spinner needs to play instantly — preload it
      video.preload = video.classList.contains('skull-spinner-video') ? 'auto' : 'none';
      video.muted = true;
      video.loop = true;
      video.playsInline = true;
      video.pause();
    });
    if (!managedVideos.length) return;

    const playIfAllowed = video => {
      const section = video.closest('.content-section');
      if (section && section.style.display === 'none') {
        video.pause();
        return;
      }
      if (document.hidden) return;
      video.play().catch(() => video.classList.add('is-blocked'));
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          const video = entry.target;
          if (entry.isIntersecting) playIfAllowed(video);
          else video.pause();
        });
      }, { rootMargin: '80px' });
      managedVideos.forEach(video => observer.observe(video));
    } else {
      managedVideos.slice(0, 2).forEach(playIfAllowed);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) managedVideos.forEach(video => video.pause());
      else managedVideos.forEach(video => {
        const rect = video.getBoundingClientRect();
        if (rect.bottom >= 0 && rect.top <= window.innerHeight) playIfAllowed(video);
      });
    });

    // ── Performance: pause CSS animations when offscreen ──
    const animatedSelectors = '.macattack-skull-container,.macattack-skull-video,.macattack-skull-svg,.skull-spinner-wrap,.skull-spinner-video,.spinner-overlay,.electric-arc,.brand-icon,.badge-live,.channel-live-dot,.stalker-live-badge';
    const animatedEls = $$(animatedSelectors);
    if (animatedEls.length && 'IntersectionObserver' in window) {
      const animObs = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          entry.target.style.animationPlayState = entry.isIntersecting ? 'running' : 'paused';
        });
      }, { rootMargin: '100px' });
      animatedEls.forEach(el => animObs.observe(el));
    }
    // Pause brand-icon animation when tab hidden
    const brandIcon = document.querySelector('.brand-icon');
    if (brandIcon) {
      document.addEventListener('visibilitychange', () => {
        brandIcon.style.animationPlayState = document.hidden ? 'paused' : 'running';
        const v = brandIcon.querySelector('video');
        if (v) v.style.animationPlayState = document.hidden ? 'paused' : 'running';
      });
    }
  }

  function openExternalEmbed(movie) {
