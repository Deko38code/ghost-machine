        item.group || '',
        item.genreName || ''
      ].join(' ')).toLowerCase().includes(maPlaylistRenderState.query));
    }

	    function renderMaPlaylistChunk(reset = false) {
	      if (!maPlaylistGrid || !window._maPlaylistData) return;
