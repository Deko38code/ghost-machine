        row.innerHTML = `
          ${item.logo ? `<img src="${esc(item.logo)}" alt="" class="playlist-ch-logo" style="width:22px;height:22px;border-radius:3px;object-fit:contain;background:#05070c;flex:0 0 auto" onerror="this.style.display='none'">` : `<span style="color:#00ff64;flex:0 0 auto">${item.type==='movies'?'🎬':item.type==='series'?'📺':'📺'}</span>`}
          <span style="color:#fff;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;flex:1">${esc(item.name || 'Channel ' + (idx + 1))}</span>
          ${item.number ? `<span style="font-size:0.62rem;color:#ffd700;flex:0 0 auto">#${esc(String(item.number))}</span>` : ''}
          ${(item.genreName || item.group) ? `<span style="font-size:0.62rem;color:#6d7b8a;flex:0 0 auto;max-width:74px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(String(item.genreName || item.group))}</span>` : ''}
          ${item.id ? `<span style="font-size:0.62rem;color:#6d7b8a;flex:0 0 auto">${esc(String(item.id))}</span>` : ''}
          <button class="ma-ch-vlc-btn" title="Launch in VLC player" style="opacity:0.4;padding:1px 6px;border-radius:3px;border:1px solid #ff660044;background:#ff660011;color:#ff6600;font-size:0.7rem;cursor:pointer;flex:0 0 auto;transition:opacity 0.15s,background 0.15s">🎯</button>`;
        row.addEventListener('click', () => playMaPlaylistItem(item));
        // VLC button — separate from row click, launches VLC externally
        const vlcBtn = row.querySelector('.ma-ch-vlc-btn');
        if (vlcBtn) {
          vlcBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            e.preventDefault();
            launchMaVlc(item, vlcBtn);
          });
          vlcBtn.addEventListener('mouseenter', () => { vlcBtn.style.opacity = '1'; vlcBtn.style.background = '#ff660033'; });
          vlcBtn.addEventListener('mouseleave', () => { vlcBtn.style.opacity = '0.4'; vlcBtn.style.background = '#ff660011'; });
