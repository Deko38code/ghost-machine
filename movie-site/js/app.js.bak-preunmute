        } else {
          // Resume only if not in player mode and reduce-motion isn't active
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!isPlaying && !reduceMotion) {
            pausedAnimations.forEach(v => { try { v.play().catch(() => {}); } catch {} });
          }
          pausedAnimations.length = 0;
        }
      });

      // ── 2. Scroll-based animation pausing: pause off-screen animated elements ──
      const animatedSelector = '.skull-icon, .stalker-live-badge, .live-pulse, [class*="Pulse"], [class*="pulse"]';
      let scrollRafPending = false;
      function pauseOffscreenAnimations() {
        if (scrollRafPending) return;
        scrollRafPending = true;
        requestAnimationFrame(() => {
          scrollRafPending = false;
          const els = document.querySelectorAll(animatedSelector);
          els.forEach(el => {
            const rect = el.getBoundingClientRect();
            const inView = rect.bottom > 0 && rect.top < window.innerHeight;
            el.style.animationPlayState = inView ? 'running' : 'paused';
          });
        });
      }
      // Throttled scroll listener
      let scrollTimer = null;
      window.addEventListener('scroll', () => {
        if (scrollTimer) return;
        scrollTimer = setTimeout(() => {
          scrollTimer = null;
          pauseOffscreenAnimations();
        }, 200);
      }, { passive: true });
      // Initial pass
      pauseOffscreenAnimations();

      // ── 3. Memory cleanup: force GC hints when player closes ──
      const origClosePlayer = window.closePlayer;
      if (typeof origClosePlayer === 'function') {
        // Wrapped in init — closePlayer is defined in same scope, call later
      }

      // ── 4. Debounced resize handler (prevents layout thrash on Windows resize) ──
      let resizeTimer = null;
      window.addEventListener('resize', () => {
        if (resizeTimer) clearTimeout(resizeTimer);
        resizeTimer = setTimeout(() => {
