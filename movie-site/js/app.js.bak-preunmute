  // ── Apply mobile-friendly attributes to any video element ──
  function applyVideoAttrs(video) {
    if (!video) return;
    video.playsInline = true;
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');
    video.setAttribute('x5-video-player-type', 'h5');
    video.setAttribute('x5-video-player-fullscreen', 'false');
    if (!video.muted) video.muted = true; // ensure autoplay works
  }

  function makeStableHlsConfig() {
    const isMobile = /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent) || window.innerWidth <= 768;
    const isLowEnd = navigator.hardwareConcurrency ? navigator.hardwareConcurrency <= 4 : false;
    // ── Server-adaptive quality: reduce buffering when server CPU is strained ──
    const serverLoad = window._cvQualityHint || 'high';
    const isServerStrained = serverLoad !== 'high';
    return {
      enableWorker: true,
      lowLatencyMode: true,               // enable LL-HLS for faster start
      liveDurationInfinity: true,
      liveSyncDurationCount: 2,           // stay 2 segments from live edge (~12s for remux) — was 1 (too aggressive for tunnel)
      liveMaxLatencyDurationCount: 5,     // max 5 segments before resync — was 4
      liveBackBufferLengthCount: 0,       // don't evict back buffer on live streams
      progressive: true,
      // ── Device + server-adaptive buffering ──
      maxBufferLength: isMobile ? (isServerStrained ? 8 : 12) : (isServerStrained ? 15 : 30),
      maxMaxBufferLength: isMobile ? (isServerStrained ? 15 : 25) : (isServerStrained ? 40 : 60),
      maxBufferSize: isMobile ? (isServerStrained ? 15*1024*1024 : 20*1024*1024) : (isServerStrained ? 30*1024*1024 : 50*1024*1024),
      maxBufferHole: isMobile ? 0.8 : 1.0,          // tighter hole tolerance on mobile
      backBufferLength: isMobile ? (isServerStrained ? 2 : 3) : (isServerStrained ? 5 : 8),
      highBufferWatchdogPeriod: isMobile ? 2 : 3,   // check stalls more often
      nudgeOffset: 0.25,
      nudgeMaxRetry: 12,
      // ── Network resilience ──
      manifestLoadingTimeOut: isMobile ? 20000 : 30000,
      manifestLoadingMaxRetry: isMobile ? 6 : 4,    // more retries on flaky mobile
      manifestLoadingRetryDelay: 1000,
      levelLoadingTimeOut: isMobile ? 20000 : 30000,
      levelLoadingMaxRetry: isMobile ? 6 : 4,
      levelLoadingRetryDelay: 1000,
      fragLoadingTimeOut: isMobile ? 20000 : 30000,
      fragLoadingMaxRetry: isMobile ? 8 : 6,
      fragLoadingRetryDelay: 1000,
      // ── Low-end device + server strain optimizations ──
      startLevel: (isLowEnd || isServerStrained) ? -1 : undefined,  // auto-start quality on strain
      abrEwmaFastEstimate: (isLowEnd || isServerStrained) ? 1.0 : undefined,
      // ── Startup optimization ──
      startFragPrefetch: true,                       // prefetch first fragment
      testBandwidth: true,
      progressive: true,
    };
  }

  function proxiedStreamUrl(streamUrl) {
    return /^https?:\/\//i.test(streamUrl)
      ? `/api/stream-proxy?url=${encodeURIComponent(streamUrl)}`
      : streamUrl;
  }

  // Play an HLS stream inline in the Live TV video area.
  function playInLiveTvSidebar(streamUrl, name) {
    const wrap = document.getElementById('livetv-video-wrap') || document.getElementById('livetv-portal-video-wrap');
    if (!wrap) return;
    // Destroy previous HLS instance
    if (window._sidebarHls) { try { window._sidebarHls.destroy(); } catch {} window._sidebarHls = null; }
    wrap.innerHTML = '';
    const video = document.createElement('video');
    video.autoplay = true;
    video.muted = true;
    video.controls = true;
    video.playsInline = true;
    video.setAttribute('playsinline', '');
    video.setAttribute('webkit-playsinline', '');
    video.setAttribute('x5-video-player-type', 'h5');
    video.setAttribute('x5-video-player-fullscreen', 'false');
    video.style.cssText = 'width:100%;height:100%;background:#000;position:absolute;top:0;left:0';
    wrap.appendChild(video);
    const urlEl = document.getElementById('livetv-video-url') || document.getElementById('livetv-portal-video-url');
    if (urlEl) urlEl.textContent = `📺 ${name}`;

    // ── Mobile: hide channel lists, show video full-width ──
    const isMobile = window.innerWidth <= 768;
    const livetvSection = document.getElementById('livetv-section');
    if (isMobile && livetvSection) {
      livetvSection.classList.add('livetv-video-active');
      // Add "Back to Channels" button if not already present
      if (!document.getElementById('livetv-back-btn')) {
        const backBtn = document.createElement('button');
        backBtn.id = 'livetv-back-btn';
        backBtn.textContent = '⬅ Back to Channels';
        backBtn.style.cssText = 'display:block;width:100%;padding:12px;margin:10px 0 0;border:none;border-radius:0 0 8px 8px;background:#e50914;color:#fff;font-size:1rem;font-weight:700;cursor:pointer;text-align:center;z-index:20';
        backBtn.onclick = () => {
          livetvSection.classList.remove('livetv-video-active');
          backBtn.remove();
        };
        const panel = document.getElementById('livetv-video-panel');
        if (panel) panel.appendChild(backBtn);
      }
      // Scroll video panel into view on mobile
      const panel = document.getElementById('livetv-video-panel');
      if (panel) panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    if (typeof Hls !== 'undefined' && Hls.isSupported()) {
      let triedProxy = false;
      const hls = new Hls(makeStableHlsConfig());
      const load = (url) => {
        if (urlEl) urlEl.textContent = `📺 ${name}`;
        hls.loadSource(url);
      };
      hls.loadSource(streamUrl);
      hls.attachMedia(video);
      hls.on(Hls.Events.MANIFEST_PARSED, () => {
        video.muted = false; video.volume = 1;
        video.play().catch(() => { video.muted = true; video.play().catch(() => {}); });
      });
      // Auto-unmute after user interaction — browsers block unmuted autoplay
      const tryUnmute = () => {
        video.muted = false;
        if (unmuteOverlay && unmuteOverlay.parentNode) unmuteOverlay.remove();
      };
      const unmuteOverlay = document.createElement('div');
      unmuteOverlay.style.cssText = 'position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.35);cursor:pointer;z-index:10;transition:opacity 0.3s ease;pointer-events:auto;';
      unmuteOverlay.innerHTML = '<div style="background:rgba(229,9,20,0.9);color:#fff;padding:10px 22px;border-radius:10px;font-size:0.85rem;font-weight:700;display:flex;align-items:center;gap:8px;box-shadow:0 4px 16px rgba(0,0,0,0.5);pointer-events:none;">🔊 Tap to Unmute</div>';
      unmuteOverlay.onclick = tryUnmute;
      wrap.appendChild(unmuteOverlay);
      video.onclick = tryUnmute;
      hls.on(Hls.Events.ERROR, (_, d) => {
        if (!d?.fatal) return;
        switch(d.type) {
          case Hls.ErrorTypes.NETWORK_ERROR: {
            const proxyUrl = proxiedStreamUrl(streamUrl);
            if (!triedProxy && proxyUrl !== streamUrl) {
              triedProxy = true;
              try { hls.stopLoad(); } catch {}
              load(proxyUrl);
            } else {
              hls.startLoad();
            }
            break;
          }
          case Hls.ErrorTypes.MEDIA_ERROR:
            hls.recoverMediaError();
            break;
          default:
            hls.destroy();
            break;
        }
      });
      window._sidebarHls = hls;
    } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
      video.src = streamUrl;
      video.muted = false; video.volume = 1;
      video.play().catch(() => { video.muted = true; video.play().catch(() => {}); });
    }
  }
