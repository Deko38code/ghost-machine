            })
          });
          const data = await res.json();
          if (data.ok) {
            setMaDebug('scanner', 'scan command accepted', 'none');
            appendMaScanOutput(`[SCAN] Started ${maIptvInput.value.trim()} prefix=${maPrefixSelect ? maPrefixSelect.value : '00:1A:79:'} speed=${maSpeedSlider ? maSpeedSlider.value : '10'}`, '#7bd4ff');
            toast('🧨 Scan started!', 'success');
            // Connect to scan events SSE for real-time progress
