  function getArchiveGenreIds(category) {
    const genreKeyMap = {
      scifi: 'scifi',
      noir: 'crime'
    };
    const key = genreKeyMap[category] || category;
    const lists = [];
    if (CURATED_LISTS[key]?.ids) lists.push(CURATED_LISTS[key].ids);
    if (CURATED_LISTS[`${key}2020s`]?.ids) lists.push(CURATED_LISTS[`${key}2020s`].ids);
    return new Set(lists.flat().map(id => String(id)));
  }

  function archiveTitleMatchesCategory(title, category) {
    const t = String(title || '').toLowerCase();
    const words = {
      action: ['war', 'fight', 'mission', 'bourne', 'wick', 'fast', 'furious', 'terminator', 'rambo', 'die hard', 'lethal weapon'],
      horror: ['horror', 'dead', 'evil', 'haunt', 'conjuring', 'scream', 'saw', 'nightmare', 'purge', 'terror', 'ghost'],
      comedy: ['comedy', 'funny', 'hangover', 'rush hour', 'shrek', 'madagascar'],
      scifi: ['sci-fi', 'science', 'space', 'alien', 'matrix', 'star wars', 'future', 'terminator', 'cyber', 'planet'],
      drama: ['drama', 'godfather', 'shawshank', 'creed', 'rocky'],
      noir: ['noir', 'detective', 'crime', 'mob', 'gangster'],
      western: ['western', 'cowboy', 'django', 'true grit'],
      animation: ['animation', 'toy story', 'shrek', 'ice age', 'kung fu panda', 'ghibli'],
      documentary: ['documentary', 'docu'],
      musical: ['musical', 'music', 'sing', 'wicked']
    };
    return (words[category] || []).some(word => t.includes(word));
  }

  function archiveMovieBelongsToCategory(movie, category) {
    if (category === 'popular') return true;
    const ids = getArchiveGenreIds(category);
    return ids.has(String(movie.id)) || archiveTitleMatchesCategory(movie.title, category);
  }

  function normalizeArchiveLocalMovie(entry, key) {
    const tmdbKeyMatch = String(key || '').match(/^tmdb_(\d+)$/i);
    const imdbId = entry.imdbId || entry.imdb || entry.omdbData?.imdbID || (/^tt\d+$/i.test(key || '') ? key : null);
    const id = entry.tmdbId || entry.id || entry.tmdbData?.id || (tmdbKeyMatch ? tmdbKeyMatch[1] : null) || imdbId;
    const title = entry.title || entry.name || entry.tmdbData?.title || entry.omdbData?.Title;
    if (!id || !title) return null;
    return {
      id,
      imdb_id: imdbId,
      title,
      poster_path: entry.poster || entry.dvdCover || '',
      backdrop_path: entry.backdrop || '',
      vote_average: entry.rating ? Number(entry.rating) : null,
      release_date: entry.year ? String(entry.year) : (entry.release_date || entry.tmdbData?.release_date || entry.omdbData?.Year || ''),
      media_type: entry.type === 'tv' || entry.type === 'series' ? 'tv' : 'movie',
      seasons: entry.seasons || null,
      number_of_seasons: entry.seasons ? Object.keys(entry.seasons).length : null,
      embed_url: entry.embedUrl || entry.embed_url || null,
      video_url: entry.videoUrl || entry.video_url || entry.url || null
    };
  }

  function archiveMovieYear(movie) {
    const raw = movie?.release_date || movie?.year || '';
    const match = String(raw).match(/\b(20\d{2}|19\d{2})\b/);
    return match ? Number(match[1]) : 0;
  }

  function getArchiveFallbackMovies() {
    return (CURATED_FALLBACK || [])
      .map(movie => ({
        ...movie,
        poster_path: movie.poster,
        vote_average: movie.rating,
        release_date: String(movie.year || ''),
        media_type: 'movie'
      }))
      .filter(movie => movie.id && movie.title);
  }

  async function getArchiveLocalMovies() {
    if (!_archiveLocalMoviesPromise) {
      _archiveLocalMoviesPromise = fetch('/api/cover-bank?all=1')
        .then(r => r.ok ? r.json() : Promise.reject(new Error('cover bank unavailable')))
        .then(data => Object.entries(data.entries || data || {})
          .filter(([, entry]) => entry && !entry.redirect && entry.type !== 'tv')
          .map(([key, entry]) => normalizeArchiveLocalMovie(entry, key))
          .filter(Boolean)
          .sort((a, b) => archiveMovieYear(b) - archiveMovieYear(a) || String(a.title).localeCompare(String(b.title))));
    }
    try {
      const movies = await _archiveLocalMoviesPromise;
      return movies.length ? movies : getArchiveFallbackMovies();
    } catch (error) {
      _archiveLocalMoviesPromise = null;
      console.warn('[Archive] cover bank unavailable, using fallback movies:', error.message);
      return getArchiveFallbackMovies();
    }
  }

  function warmArchiveLocalMovies() {
    if (!_archiveLocalMoviesPromise) {
      _archiveLocalMoviesPromise = getArchiveLocalMovies().catch(() => {
        _archiveLocalMoviesPromise = null;
        return getArchiveFallbackMovies();
      });
    }
    return _archiveLocalMoviesPromise;
  }

  function initArchiveSearch() {
    console.log('[Archive] initArchiveSearch called, _archiveInited=', _archiveInited);
    if (_archiveInited) return;
    _archiveInited = true;
    const grid  = document.getElementById('archive-grid');
    const empty = document.getElementById('archive-empty');
    console.log('[Archive] grid=', !!grid, 'empty=', !!empty, 'catBtns=', document.querySelectorAll('.archive-cat-btn').length);
    if (!grid) return;

    function renderArchiveLocalMovies(movies) {
      grid.innerHTML = '';
      if (!movies.length) return false;
      movies.slice(0, 80).forEach(movie => grid.appendChild(movieCard(movie, true)));
      return true;
    }

    // Paint something immediately so hard refreshes don't sit on a blank archive tab.
    renderArchiveLocalMovies(getArchiveFallbackMovies().slice(0, 24));
    warmArchiveLocalMovies().then(movies => {
      if (currentPage === 'archive' && grid && movies.length) {
        renderArchiveLocalMovies(movies.slice(0, 80));
      }
    }).catch(() => {});

    async function runSearch(q) {
      q = q.trim();
      console.log('[Archive] runSearch called with q=' + q);
      grid.innerHTML = '<div style="color:#888;padding:20px">Searching...</div>';
      empty.style.display = 'none';
      if (!q) { grid.innerHTML = ''; return; }
      try {
        const localMovies = await getArchiveLocalMovies();
        const normalizedQ = q.toLowerCase();
        const isCategorySearch = (ARCHIVE_CATEGORY_QUERIES[_currentArchiveCat] || _currentArchiveCat) === q;
        const localResults = localMovies.filter(movie => {
          if (isCategorySearch) return archiveMovieBelongsToCategory(movie, _currentArchiveCat);
          return bankResultMatchesQuery(normalizedQ, movie);
        });
        if (renderArchiveLocalMovies(localResults)) return;
        grid.innerHTML = '';
        empty.style.display = '';
      } catch(e) {
        const fallback = getArchiveFallbackMovies().filter(movie => {
