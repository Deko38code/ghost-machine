  async function loadFranchiseSection(sectionId, rowId) {
    const row = document.getElementById(rowId);
    if (!row) return;
    showSkeletons(row, 8);

    const config = FRANCHISE_ROWS[sectionId];
    const ids = [...new Set(config?.data?.ids || [])]; // dedupe
    const isTV = config?.data?.type === 'tv';

    // Skip TMDB for IMDB-style IDs — they need numeric TMDB IDs, not tt-prefixed ones
    const numericIds = ids.filter(id => !/^tt\d+$/i.test(String(id)));
    const imdbIds = ids.filter(id => /^tt\d+$/i.test(String(id)));

    let resolvedMovies = [];

    // 1. Resolve numeric IDs via TMDB (fast, rich data)
    if (CONFIG.tmdb.apiKey && numericIds.length) {
      try {
        const fetcher = isTV ? (id => tmdbApi.tvDetails(id)) : (id => tmdbApi.movieDetails(id));
        const movies = await Promise.all(numericIds.slice(0, 12).map(id => fetcher(id).catch(() => null)));
        movies.filter(Boolean).forEach(m => resolvedMovies.push(m));
      } catch {}
    }

    // 2. Resolve IMDB-style IDs via Cinemeta
    if (imdbIds.length) {
      try {
        const cinemetaMovies = await loadCinemetaBatch(imdbIds, isTV);
        cinemetaMovies.forEach(m => resolvedMovies.push(m));
      } catch {}
    }

    // 3. If we got any movies, render them
    if (resolvedMovies.length) {
      row.innerHTML = '';
      const seen = new Set();
      resolvedMovies.forEach(m => {
        const mid = m.id || m.tmdb_id;
        if (seen.has(mid)) return; seen.add(mid);
        appendCard(row, movieCard(m), mid);
      });
      return;
    }

    // Cinemeta fallback — fetch real data with real posters
    if (ids.length) {
      row.innerHTML = '';
      try {
        const movies = await loadCinemetaBatch(ids.slice(0, 12), isTV);
        if (movies.length) {
          const seen2 = new Set();
          movies.forEach(m => {
            const mid = m.id || m.tmdb_id;
            if (seen2.has(mid)) return; seen2.add(mid);
            appendCard(row, movieCard(m), mid);
          });
          return;
        }
      } catch {}
    }

    // Last resort — use curated list titles with TMDB poster paths
