  // ══ DATA FETCHING ══
  // ══════════════════════════════════════════════════════════════════════
  function getImdbId(tmdbId) {
    if (/^tt\d+$/i.test(String(tmdbId || ''))) return String(tmdbId);
    return TMDB_TO_IMDB[tmdbId] || null;
  }

  // ── UNIFIED DATA FETCHER ──
  // Try TMDB first (if key exists), then Cinemeta via IMDB ID, then fallback cached data
  async function fetchMovieData(tmdbId, isTV = false) {
    const fallback = CURATED_FALLBACK.find(m => m.id === tmdbId);
    const isTVShow = isTV || (fallback && !!fallback.first_air_date);

    // If tmdbId is an IMDB-style ID (tt12345678), skip TMDB — TMDB needs numeric IDs.
    // Sending IMDB IDs to /movie/{tt...} causes wrong-data or 404 responses.
    const isImdbId = /^tt\d+$/i.test(String(tmdbId || ''));

    // 1. Try TMDB if key exists AND tmdbId is numeric (with 5s timeout fallback)
    if (CONFIG.tmdb.apiKey && !isImdbId) {
      try {
        const fetcher = isTVShow ? (id => tmdbApi.tvDetails(id)) : (id => tmdbApi.movieDetails(id));
        const movie = await fetcher(tmdbId);
        if (movie) {
          currentMovieData = movie;
          return { source: 'tmdb', data: movie };
        }
      } catch {}
    }

    // 2. Try Cinemeta via IMDB ID lookup
    const directImdbId = typeof tmdbId === 'string' && /^tt\d+$/i.test(tmdbId) ? tmdbId : null;
    const imdbId = directImdbId || getImdbId(tmdbId);
    if (imdbId) {
      try {
        // Parallel Cinemeta lookup — don't wait for tv if movie resolves first
        const [cmTv, cmMovie] = await Promise.all([
          cinemetaApi.tvDetails(imdbId).catch(() => null),
          cinemetaApi.movieDetails(imdbId).catch(() => null),
        ]);
        const cm = cmTv || cmMovie;
        if (cm) {
          // ALWAYS prefer fallback title when available — Cinemeta search returns wrong titles for some TMDB IDs
          const fallbackTitle = fallback ? fallback.title : null;
          const resolvedTitle = fallbackTitle || cm.name || `#${tmdbId}`;
          // Normalize Cinemeta data to look like TMDB data
          const normalized = {
            id: cm.tmdbId || (isImdbId ? (IMDB_TO_TMDB[String(tmdbId)] || tmdbId) : tmdbId),
            imdb_id: imdbId,
            title: resolvedTitle,
            name: resolvedTitle,
            overview: cm.description || fallback?.overview || '',
            poster_path: null, // Use Cinemeta poster directly
            backdrop_path: null,
            vote_average: parseFloat(cm.imdbRating) || (fallback ? fallback.rating : null),
            release_date: cm.year ? String(cm.year) : (fallback ? String(fallback.year) : ''),
            first_air_date: cm.type === 'series' ? (cm.year ? String(cm.year) : '') : '',
            genre: cm.genre || [],
            genres: (cm.genre || []).map(g => ({ id: 0, name: g })),
            runtime: cm.runtime ? parseInt(cm.runtime) : null,
            media_type: cm.type === 'series' ? 'tv' : 'movie',
            _cinemeta: cm,
            _source: 'cinemeta',
          };
          currentMovieData = normalized;
          return { source: 'cinemeta', data: normalized };
        }
      } catch {}
    }

    // 3. Fallback to cached/curated data
    if (fallback) {
      const normalized = {
        id: fallback.id,
        title: fallback.title,
        name: fallback.title,
        overview: '',
        poster_path: fallback.poster,
        backdrop_path: null,
        vote_average: fallback.rating,
        release_date: String(fallback.year),
        media_type: 'movie',
        _source: 'fallback',
      };
      currentMovieData = normalized;
      return { source: 'fallback', data: normalized };
    }

    // 4. Last resort — minimal data with TMDB ID only
    // For IMDB-style IDs (tt...), include imdb_id so playback still works
    const isImdbMinimal = /^tt\d+$/i.test(String(tmdbId || ''));
    // Try to get a real title from CoverArtCache or search bank
    let fallbackTitle = `#${tmdbId}`;
    try {
      const cached = typeof CoverArtCache !== 'undefined' ? CoverArtCache.get(tmdbId) : null;
      if (cached && cached.title) fallbackTitle = cached.title;
    } catch {}
    const minimal = {
      id: tmdbId,
      title: fallbackTitle,
      name: fallbackTitle,
      overview: '',
      media_type: isTVShow ? 'tv' : 'movie',
      _source: 'none',
      ...(isImdbMinimal ? { imdb_id: tmdbId } : {}),
    };
    currentMovieData = minimal;
    return { source: 'none', data: minimal };
  }

