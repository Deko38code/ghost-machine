      if (franchiseList) franchiseList.innerHTML = '<div style="text-align:center;color:var(--text-muted)">Could not load results</div>';
    }

    // ── MacAttack Desktop App status polling ──
    const maStatusEl = document.getElementById('wd-macattack-status');
    const maPidEl = document.getElementById('wd-macattack-pid');
    const maUptimeEl = document.getElementById('wd-macattack-uptime');
    const maCpuEl = document.getElementById('wd-macattack-cpu');
    const maMemEl = document.getElementById('wd-macattack-mem');

    async function pollMacAttack() {
    window.pollMacAttack = pollMacAttack;
      try {
        const res = await fetch('/api/macattack/status');
        const data = await res.json();
        if (data.running) {
          if (maStatusEl) { maStatusEl.textContent = 'RUNNING'; maStatusEl.style.background = '#003311'; maStatusEl.style.color = '#00ff64'; }
          // Update scanner tab Start/Stop buttons to match running state
          const scanStart = document.getElementById('ma-start-btn');
          const scanStop = document.getElementById('ma-stop-btn');
          if (scanStart) { scanStart.disabled = true; scanStart.style.opacity = '0.5'; scanStart.textContent = '⏳ Running...'; }
          if (scanStop) { scanStop.disabled = false; scanStop.style.opacity = '1'; }
          if (maPidEl) maPidEl.textContent = data.pid;
          if (maUptimeEl) maUptimeEl.textContent = data.uptime || '—';
          if (maCpuEl) maCpuEl.textContent = data.cpu || '—';
          if (maMemEl) maMemEl.textContent = data.mem || '—';
        } else {
          if (maStatusEl) { maStatusEl.textContent = 'STOPPED'; maStatusEl.style.background = '#330011'; maStatusEl.style.color = '#e50914'; }
          // Reset scanner tab Start/Stop buttons to idle state
          const scanStart = document.getElementById('ma-start-btn');
          const scanStop = document.getElementById('ma-stop-btn');
          if (scanStart) { scanStart.disabled = false; scanStart.style.opacity = '1'; scanStart.textContent = '▶ Start'; }
          if (scanStop) { scanStop.disabled = true; scanStop.style.opacity = '0.5'; }
          if (maPidEl) maPidEl.textContent = '—';
          if (maUptimeEl) maUptimeEl.textContent = '—';
          if (maCpuEl) maCpuEl.textContent = '—';
          if (maMemEl) maMemEl.textContent = '—';
        }
      } catch {
        if (maStatusEl) { maStatusEl.textContent = 'ERROR'; maStatusEl.style.background = '#332200'; maStatusEl.style.color = '#ffaa00'; }
      }
    }
    if (isPageActive('watchdog')) pollMacAttack();
    if (!macAttackStatusPollId) {
      macAttackStatusPollId = setInterval(() => {
        if (isPageActive('watchdog')) pollMacAttack();
      }, 30000);
    }

    // ── MacAttack Tab Switching & all event listeners are in bindEvents() ──
    // …only polling/data-refresh functions remain here…

    // ── MacAttack Console Log Streaming ──
    const maOutputEl = document.getElementById('wd-macattack-output');
    const maErrorsEl = document.getElementById('wd-macattack-errors');
    const maClearBtn = document.getElementById('wd-macattack-clearlogs');
    const maAutoScroll = document.getElementById('wd-macattack-autoscroll');
    const maCurrentMacLiveEl = document.getElementById('ma-current-mac');

    function updateMacAttackCurrentMac(outputText) {
      if (!maCurrentMacLiveEl) return;
      const macMatches = [...(outputText || '').matchAll(/\b(?:[0-9A-F]{2}:){5}[0-9A-F]{2}\b/gi)];
      if (!macMatches.length) return;
      const latest = macMatches[macMatches.length - 1][0].toUpperCase();
      maCurrentMacLiveEl.textContent = latest;
    }

    async function pollMacAttackLogs() {
    window.pollMacAttackLogs = pollMacAttackLogs;
      if (!maOutputEl && !maErrorsEl) return;
      try {
        const [outRes, errRes] = await Promise.all([
          fetch('/api/macattack/output-log?lines=300'),
          fetch('/api/macattack/error-log?lines=300')
        ]);
        if (outRes.ok && maOutputEl) {
          const outText = await outRes.text();
          // Only update if content changed (avoid flicker)
          if (outText.trim() !== maOutputEl.textContent.trim()) {
            maOutputEl.textContent = outText;
            updateMacAttackCurrentMac(outText);
            if (maAutoScroll && maAutoScroll.checked) {
              maOutputEl.scrollTop = maOutputEl.scrollHeight;
            }
          }
        }
        if (errRes.ok && maErrorsEl) {
          const errText = await errRes.text();
          if (errText.trim() !== maErrorsEl.textContent.trim()) {
            maErrorsEl.textContent = errText;
            if (maAutoScroll && maAutoScroll.checked) {
              maErrorsEl.scrollTop = maErrorsEl.scrollHeight;
            }
          }
        }
      } catch (e) {
        // Silently fail — log polling is non-critical
      }
    }

    // Poll logs only while the MacAttack page is visible; repeated background polling slows the browser.
    if (!macAttackLogPollId) {
      macAttackLogPollId = setInterval(async () => {
        if (!isPageActive('watchdog')) return;
      try {
        const res = await fetch('/api/macattack/status');
        const data = await res.json();
        if (data.running) pollMacAttackLogs();
      } catch {}
      }, 10000);
    }

    // Wire up buttons
    const runBtn = document.getElementById('wd-run-now');
    const refreshBtn = document.getElementById('wd-refresh');

    if (runBtn) {
      runBtn.onclick = async () => {
        runBtn.disabled = true;
        runBtn.textContent = '⏳ Running...';
        try {
          // Trigger flix-AI via server exec
          const res = await fetch('/api/flix-ai-status');
          if (res.ok) {
            showToast('💀 MacAttack starting... check back in a few minutes.');
            // Auto-refresh every 30s while running
            const pollId = setInterval(async () => {
              const pRes = await fetch('/api/flix-ai-status');
              const pData = await pRes.json();
              if (pData.status !== 'running') {
                clearInterval(pollId);
                renderWatchdog();
              } else {
                // Update progress bar
                renderWatchdog();
              }
            }, 30000);
          }
        } catch {
          showToast('⚠️ Server not running — start with: pm2 start ecosystem.config.js', 'error');
        }
        setTimeout(() => { runBtn.disabled = false; runBtn.innerHTML = '<span style="display:inline-flex;width:24px;height:24px;overflow:hidden;border-radius:5px;background:#000"><video src="/assets/macattack/intro.mp4" muted loop playsinline preload="none" style="width:100%;height:100%;object-fit:cover;display:block"></video></span><span>Run MacAttack</span>'; setupLazySiteVideos(); }, 5000);
      };
    }
    if (refreshBtn) {
      refreshBtn.onclick = () => renderWatchdog();
    }

    // ── Render AI Brain panel ──
    renderBrainPanel();

    // ── Render scraping run log ──
    renderRunLog();
  }

