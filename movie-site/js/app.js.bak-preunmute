  function normalizeSearchQuery(query) {
    return String(query || '').trim().replace(/\s+/g, ' ');
  }

  function searchResultKey(movie) {
    const id = movie?.tmdbId || movie?.id;
    if (id) return `id:${id}`;
    return `title:${String(movie?.title || movie?.name || '').toLowerCase()}|${movie?.year || movie?.release_date || movie?.first_air_date || ''}`;
  }

  function normalizeBankSearchResult(movie) {
    const imdbId = movie.imdbId || movie.imdb_id || movie.imdb || movie.omdbData?.imdbID || null;
    return {
      id: movie.tmdbId || movie.id || imdbId,
      imdb_id: imdbId,
      title: movie.title,
      poster_path: movie.poster,
      vote_average: Number(movie.omdbData?.imdbRating || movie.rating || 0),
      release_date: movie.type === 'tv' ? '' : String(movie.year || ''),
      first_air_date: movie.type === 'tv' ? String(movie.year || '') : '',
      media_type: movie.type === 'tv' || movie.type === 'series' ? 'tv' : 'movie',
      overview: movie.omdbData?.plot || movie.description || '',
      seasons: movie.seasons || null,
      number_of_seasons: movie.seasons ? Object.keys(movie.seasons).length : null,
      embed_url: movie.embedUrl || movie.embed_url || null,
      video_url: movie.videoUrl || movie.video_url || movie.url || null
    };
  }

  function normalizeClientSearchText(value) {
    return String(value || '').toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9]+/g, ' ').trim();
  }

  function bankResultMatchesQuery(query, movie) {
    const q = normalizeClientSearchText(query);
    const title = normalizeClientSearchText(movie?.title || movie?.name);
    if (!q || !title) return false;
    if (title === q || title.startsWith(q) || title.includes(q)) return true;
    const queryWords = q.split(/\s+/).filter(Boolean);
    const titleWords = title.split(/\s+/).filter(Boolean);
    return queryWords.every(word =>
      titleWords.some(titleWord =>
        titleWord === word ||
        (word.length >= 3 && titleWord.startsWith(word)) ||
        (word.length >= 3 && word.startsWith(titleWord))
      )
    );
  }

  function searchResultMatchesQuery(query, movie) {
    const q = normalizeClientSearchText(query);
    const title = normalizeClientSearchText(movie?.title || movie?.name);
    if (!q || !title) return false;
    if (title === q || title.startsWith(q) || title.includes(q)) return true;
    const queryWords = q.split(/\s+/).filter(Boolean);
    const titleWords = title.split(/\s+/).filter(Boolean);
    return queryWords.every(word =>
      titleWords.some(titleWord =>
        titleWord === word ||
        (word.length >= 3 && titleWord.startsWith(word)) ||
        (word.length >= 3 && word.startsWith(titleWord))
      )
    );
  }

  function sortSearchResultsByQuery(results, exactQ) {
    return results.slice().sort((a, b) => {
      const at = normalizeClientSearchText(a?.title || a?.name);
      const bt = normalizeClientSearchText(b?.title || b?.name);
      const ae = at === exactQ;
      const be = bt === exactQ;
      if (ae !== be) return ae ? -1 : 1;
      const as = at.startsWith(exactQ);
      const bs = bt.startsWith(exactQ);
      if (as !== bs) return as ? -1 : 1;
      const ai = at.includes(exactQ);
      const bi = bt.includes(exactQ);
      if (ai !== bi) return ai ? -1 : 1;
      const am = (a.media_type || 'movie') === 'movie' ? 0 : 1;
      const bm = (b.media_type || 'movie') === 'movie' ? 0 : 1;
      return am - bm;
    });
  }

  function compactSearchTerms(value) {
    return normalizeClientSearchText(value)
      .replace(/\b(is|the|a|an|of|and|to)\b/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function searchDotSignature(value) {
    return compactSearchTerms(value).replace(/\s+/g, '');
  }

  function searchDotMatch(query, title) {
    const q = searchDotSignature(query);
    const t = searchDotSignature(title);
    if (!q || !t) return false;
    return t.includes(q) || q.includes(t);
  }

  async function lookupTitleOutsideBank(query) {
    const variants = Array.from(new Set([
      query,
      normalizeSearchQuery(query).replace(/\b(is|the|a|an|of|and)\b/gi, ' ').replace(/\s+/g, ' ').trim(),
      normalizeSearchQuery(query).replace(/[’']/g, '').replace(/\s+/g, ' ').trim(),
    ].filter(Boolean)));

    try {
      for (const variant of variants) {
        const bankRes = await fetch(`/api/cover-bank?search=${encodeURIComponent(variant)}`);
        if (bankRes.ok) {
          const bankData = await bankRes.json();
          const bankMovies = Object.values(bankData || {})
            .filter(m => m && m.title && !m.redirect && bankResultMatchesQuery(variant, m))
            .sort((a, b) => {
              const at = normalizeClientSearchText(a.title);
              const bt = normalizeClientSearchText(b.title);
              const q = normalizeClientSearchText(variant);
              if (at === q && bt !== q) return -1;
              if (bt === q && at !== q) return 1;
              return parseInt(b.year || 0) - parseInt(a.year || 0);
            });
          if (bankMovies.length) return bankMovies.map(normalizeBankSearchResult);
        }

        const r = await fetch(`/api/cover-art?title=${encodeURIComponent(variant)}&type=movie`);
        if (!r.ok) continue;
        const result = await r.json();
        if (!result || result.error || !result.title) continue;
        const wanted = normalizeSearchQuery(variant).toLowerCase();
        const found = normalizeSearchQuery(result.title).toLowerCase();
        if (wanted && found && found !== wanted && !found.includes(wanted) && !wanted.includes(found)) continue;
        return [normalizeBankSearchResult(result)];
      }
      return [];
    } catch {
      return [];
    }
  }

  function addSearchResults(target, movies, mapper = m => m) {
    const seen = new Set(target.map(searchResultKey));
    (movies || []).forEach(movie => {
      if (!movie) return;
      const normalized = mapper(movie);
      const key = searchResultKey(normalized);
      if (seen.has(key)) return;
      seen.add(key);
      target.push(normalized);
    });
  }

