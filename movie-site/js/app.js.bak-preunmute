  function showPlayerSpinner(text) {
    if (!playerSpinner) return;
    playerSpinner.classList.remove('hidden', 'connected', 'error');
    // Force display:flex in case CSS override hides it
    playerSpinner.style.display = 'flex';
    const spinText = playerSpinner.querySelector('.spinner-text');
    if (spinText) spinText.textContent = text || 'Loading...';
    setSkullEyes('red');
    // Ensure skull intro video is playing (autoplay can be blocked by browsers)
    const spinnerVideo = playerSpinner.querySelector('.skull-spinner-video');
    if (spinnerVideo) {
      // FIX: Play FIRST, then seek after playback starts.
      // Setting currentTime before play() causes the video to freeze on
      // a single frame because seeking hasn't completed yet.
      const seekAfterPlay = () => {
        spinnerVideo.currentTime = 5;
        spinnerVideo.removeEventListener('playing', seekAfterPlay);
      };
      spinnerVideo.addEventListener('playing', seekAfterPlay);
      if (spinnerVideo.paused) {
        const playPromise = spinnerVideo.play();
        if (playPromise) {
          playPromise.catch(() => {
            // Autoplay blocked — still try to seek to 5s so paused frame shows skull
            spinnerVideo.currentTime = 5;
            spinnerVideo.removeEventListener('playing', seekAfterPlay);
          });
        } else {
          // Synchronous play (older browsers) — seek immediately
          spinnerVideo.currentTime = 5;
          spinnerVideo.removeEventListener('playing', seekAfterPlay);
        }
      } else {
        // Already playing — just seek
        spinnerVideo.currentTime = 5;
      }
    }
  }
  window.showPlayerSpinner = showPlayerSpinner;

