                if (hitsEl) hitsEl.textContent = 'Hits: ' + (prev + 1);
                // Add to hit list box
                const hitList = document.getElementById('ma-hit-list');
                if (hitList) {
                  // Remove placeholder text on first hit
                  if (hitList.querySelector('div[style*="italic"]')) hitList.innerHTML = '';
                  const hitUrl = d.url || document.getElementById('stalker-url')?.value || document.getElementById('ma-url')?.value || '';
                  const chInfo = d.channelCount ? `${d.channelCount}ch` : '?ch';
                  const streamIcon = d.streamWorks ? '🟢' : (d.channelCount > 0 ? '🔴' : '⚪');
                  const subInfo = d.tariffPlanId > 0 ? '⭐' : '';
                  const entry = document.createElement('div');
                  entry.style.cssText = 'padding:4px 6px;margin:2px 0;border-radius:4px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;transition:background 0.15s';
                  entry.style.background = '#0d2b0d';
                  entry.innerHTML = `<span style="color:#00ff64;font-weight:600">${streamIcon} ${d.mac}${subInfo}</span><span style="color:#7bd4ff;font-size:0.75rem">${chInfo}</span>`;
                  entry.addEventListener('mouseenter', () => entry.style.background = '#1a4a1a');
                  entry.addEventListener('mouseleave', () => entry.style.background = '#0d2b0d');
                  entry.addEventListener('click', () => {
                    // Load this MAC into Player tab fields
                    const hostInput = document.getElementById('ma-host-input') || document.getElementById('stalker-url');
                    const macInput = document.getElementById('ma-mac-input') || document.getElementById('stalker-mac');
