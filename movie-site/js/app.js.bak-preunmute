  // ── STALKER STREAM DIRECT PLAYER ──
  // Plays a channel directly without re-fetching the channel list
  function playStalkerStreamDirect(portalUrl, mac, channelCmd, channelDisplayName, linkType) {
    const base = portalUrl.replace(/\/+$/, '');
    currentMovieId = null;
    currentIsTV = false;
    currentSource = 'stalker';
    playerOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    isPlaying = true;
    if (playerPlayBtn) { playerPlayBtn.textContent = '⏸'; playerPlayBtn.title = 'Pause'; }
    isPaused = false;
    const skHeader = playerOverlay.querySelector('.player-header');
    if (skHeader) skHeader.style.opacity = '1';
    if (playerControls) playerControls.style.opacity = '1';
    playerOverlay.style.cursor = 'default';
    if (playerTitle) playerTitle.textContent = `📺 ${channelDisplayName || 'Live TV'}`;
    showPlayerSpinner(`💀 Connecting to ${channelDisplayName || 'stream'}...`);
    setSkullEyes('red');
    const tabs = document.getElementById('player-source-tabs');
    if (tabs) tabs.style.display = 'none';
    showStalkerUrlMac(portalUrl, mac);
    window._stalkerLastCmd = channelCmd;

    // Build the video element
    playerVideoWrap.innerHTML = '';
    const video = document.createElement('video');
    video.id = 'live-hls-player';
    video.autoplay = true;
    video.muted = true;
    video.playsInline = true;
    video.style.cssText = 'width:100%;height:100%;background:#000;position:absolute;top:0;left:0;opacity:0;transition:opacity 0.3s ease;';
    playerVideoWrap.appendChild(video);
    playerElement = video;

    // Debug panel
    const dbg = document.createElement('div');
    dbg.id = 'stalker-debug-panel';
    dbg.style.cssText = 'position:absolute;bottom:60px;left:10px;max-width:420px;max-height:260px;overflow-y:auto;background:rgba(0,0,0,0.88);border:1px solid #e50914;border-radius:6px;padding:10px 14px;font-size:11px;color:#0f0;z-index:5;font-family:monospace;pointer-events:none;display:none;';
    dbg.innerHTML = `<div style="color:#e50914;font-weight:bold;margin-bottom:4px;">💀 STREAM DEBUGGER</div><div id="dbg-lines"></div>`;
    playerVideoWrap.appendChild(dbg);
    const dbgLines = dbg.querySelector('#dbg-lines');
    function dbgLog(msg, color) {
      if (!dbgLines) return;
      const line = document.createElement('div');
      line.style.color = color || '#0f0';
      line.textContent = `[${new Date().toLocaleTimeString()}] ${msg}`;
      dbgLines.appendChild(line);
      dbgLines.scrollTop = dbgLines.scrollHeight;
    }
    dbgLog(`Channel: ${channelDisplayName}`, '#fff');
    dbgLog(`Portal: ${base}`, '#888');
    dbgLog(`MAC: ${mac}`, '#888');
    dbgLog(`Raw cmd: ${channelCmd?.substring(0, 80)}`, '#ff0');

    // Resolve stream URL
    let streamUrl = channelCmd;
    if (streamUrl.startsWith('ffmpeg ')) streamUrl = streamUrl.substring(7);

    function doLoadHls(videoEl, url) {
      // ALL stalker portal streams route through /api/stalker-hls (handshake + create_link + ffmpeg HLS transcode)
      // /api/stalker-stream returns raw MPEG-TS which browsers CANNOT play — never use it for browser playback
      if (mac && channelCmd && !url.startsWith('/api/stalker-hls')) {
        dbgLog('Routing through /api/stalker-hls for HLS transcode', '#ff0');
        const lt = linkType || 'itv';
        url = `/api/stalker-hls?url=${encodeURIComponent(base)}&mac=${encodeURIComponent(mac)}&cmd=${encodeURIComponent(channelCmd)}&linkType=${encodeURIComponent(lt)}`;
      }
      const isHLS = url.includes('.m3u8') || url.includes('m3u8') || url.includes('/api/stalker-hls');
      const isStalker = url.includes('cdnip') || url.includes('play_token') || url.includes('/ch/') || url.includes('/api/stalker-hls');
      const isDirectMp4 = !isHLS && !isStalker && (url.includes('.mp4') || url.includes('.mkv'));

      // Live badge
      const liveBadge = document.createElement('div');
      liveBadge.id = 'live-badge';
      liveBadge.style.cssText = 'position:absolute;top:12px;right:12px;background:#e50914;color:#fff;font-size:0.7rem;font-weight:bold;padding:3px 8px;border-radius:3px;z-index:15;animation:blink 1.5s infinite;display:none;';
      liveBadge.textContent = '🔴 LIVE';
      playerVideoWrap.appendChild(liveBadge);

      if (isHLS && typeof Hls !== 'undefined' && Hls.isSupported()) {
        dbgLog('HLS stream — using HLS.js', '#0f0');
        const hls = new Hls(makeStableHlsConfig());
        hls.loadSource(url);
        hls.attachMedia(videoEl);
        hls.on(Hls.Events.MANIFEST_PARSED, () => {
          dbgLog('HLS manifest parsed — playing', '#0f0');
          forceBestHlsQuality(hls, channelDisplayName);
          videoEl.style.opacity = '1';
          hidePlayerSpinner();
          liveBadge.style.display = 'block';
          setSkullEyes('green');
          videoEl.play().catch(() => { videoEl.muted = true; videoEl.play().catch(() => {}); });
        });
        // Fallback: if manifest fires but video stays invisible (e.g. play() delayed)
        videoEl.addEventListener('timeupdate', function onTime() {
          if (videoEl.style.opacity !== '1') {
            videoEl.style.opacity = '1';
            hidePlayerSpinner();
            liveBadge.style.display = 'block';
          }
          videoEl.removeEventListener('timeupdate', onTime);
        });
        hls.on(Hls.Events.ERROR, (ev, data) => {
          dbgLog(`HLS error: ${data.type} ${data.details}`, '#f00');
          if (data.fatal) {
            if (data.type === Hls.ErrorTypes.NETWORK_ERROR) { dbgLog('Network error — retrying in 3s...', '#ff0'); setTimeout(() => hls.startLoad(), 3000); }
            else if (data.type === Hls.ErrorTypes.MEDIA_ERROR) { dbgLog('Media error — recovering...', '#ff0'); hls.recoverMediaError(); }
            else { dbgLog('Fatal HLS error', '#f00'); hidePlayerSpinner(); }
          }
        });
      } else if (isStalker && !isHLS) {
        // MPEG-TS through stalker-stream proxy — try direct src first
        dbgLog('Stalker stream (MPEG-TS) — direct video.src', '#0f0');
        // Also try HLS.js — stalker-stream might be doing server-side transmux
        if (typeof Hls !== 'undefined' && Hls.isSupported()) {
          dbgLog('Trying HLS.js for transmuxed stream...', '#ff0');
          const hls = new Hls(makeStableHlsConfig());
          hls.loadSource(url);
          hls.attachMedia(videoEl);
          hls.on(Hls.Events.MANIFEST_PARSED, () => {
            dbgLog('Transmux HLS manifest OK — playing', '#0f0');
            forceBestHlsQuality(hls, channelDisplayName);
            videoEl.play().catch(() => {});
            hidePlayerSpinner();
            videoEl.style.opacity = '1';
            liveBadge.style.display = 'block';
            setSkullEyes('green');
          });
          hls.on(Hls.Events.ERROR, (ev, data) => {
            dbgLog(`Transmux HLS error: ${data.type} ${data.details}`, '#f00');
            if (data.fatal) {
              dbgLog('HLS.js transmux failed — trying direct src', '#ff0');
              hls.destroy();
              videoEl.src = url;
              videoEl.play().catch(() => {});
              hidePlayerSpinner();
              videoEl.style.opacity = '1';
            }
          });
        } else {
          videoEl.src = url;
          videoEl.play().catch(() => {});
          hidePlayerSpinner();
          videoEl.style.opacity = '1';
        }
      } else {
        dbgLog('Direct playback', '#0f0');
        videoEl.src = url;
        videoEl.play().catch(() => {});
        hidePlayerSpinner();
        videoEl.style.opacity = '1';
      }
    }

    // For stalker portal /ch/ URLs, skip client-side create_link — /api/stalker-hls does it server-side
    // This is the ONLY way MPEG-TS streams can play in the browser (ffmpeg transcode to HLS segments)
    if (streamUrl.includes('localhost') || streamUrl.includes('/ch/') || !streamUrl.startsWith('http')) {
      dbgLog('Using /api/stalker-hls for ffmpeg transcode...', '#0f0');
      const lt = linkType || 'itv';
      const hlsProxyUrl = `/api/stalker-hls?url=${encodeURIComponent(base)}&mac=${encodeURIComponent(mac)}&cmd=${encodeURIComponent(channelCmd)}&linkType=${encodeURIComponent(lt)}`;
      // /api/stalker-hls returns an HLS master playlist — load via HLS.js
      if (typeof Hls !== 'undefined' && Hls.isSupported()) {
        dbgLog('Loading HLS.js with stalker-hls transcode...', '#0f0');
        const hls = new Hls(makeStableHlsConfig());
        hls.loadSource(hlsProxyUrl);
        hls.attachMedia(video);
        hls.on(Hls.Events.MANIFEST_PARSED, () => {
          dbgLog('HLS transcode manifest OK — playing!', '#0f0');
          forceBestHlsQuality(hls, channelCmd || 'stalker');
          video.play().catch(() => { video.muted = true; video.play().catch(() => {}); });
          hidePlayerSpinner();
          video.style.opacity = '1';
          const liveBadge = document.getElementById('live-badge');
          if (liveBadge) liveBadge.style.display = 'block';
          setSkullEyes('green');
        });
        hls.on(Hls.Events.ERROR, (ev, data) => {
          dbgLog(`HLS transcode error: ${data.type} ${data.details}`, '#f00');
          if (data.fatal) {
            if (data.type === Hls.ErrorTypes.NETWORK_ERROR) {
              dbgLog('Network error — retrying in 5s...', '#ff0');
              setTimeout(() => hls.startLoad(), 5000);
            } else {
              dbgLog('Fatal HLS transcode error — stream may be down', '#f00');
              hidePlayerSpinner();
              toast('💀 Stream failed — try another channel', 'warning');
            }
          }
        });
      } else {
        // No HLS.js — direct src (won't work for MPEG-TS but try anyway)
        dbgLog('No HLS.js — trying direct (will fail for MPEG-TS)', '#ff0');
        video.src = hlsProxyUrl;
        video.play().catch(() => {});
        hidePlayerSpinner();
        video.style.opacity = '1';
      }
    } else if (streamUrl.startsWith('http')) {
      // Direct CDN URL (already resolved) — play via doLoadHls
      dbgLog('Direct URL — playing', '#0f0');
      doLoadHls(video, streamUrl);
    } else {
      dbgLog(`Cannot parse cmd: ${streamUrl?.substring(0,60)}`, '#f00');
      hidePlayerSpinner();
    }

    // FireDragon/strict autoplay fix: retry play on canplay/loadeddata
    video.addEventListener('canplay', function forcePlay() {
      if (video.paused) {
        dbgLog('canplay fired — forcing play()', '#0ff');
        video.play().catch(() => { video.muted = true; video.play().catch(() => {}); });
      }
      video.removeEventListener('canplay', forcePlay);
    }, { once: true });
    video.addEventListener('loadeddata', function forcePlay2() {
      if (video.paused) {
        dbgLog('loadeddata fired — forcing play()', '#0ff');
        video.play().catch(() => { video.muted = true; video.play().catch(() => {}); });
      }
      video.removeEventListener('loadeddata', forcePlay2);
    }, { once: true });
    video.addEventListener('playing', () => {
      video.style.opacity = '1';
      liveBadge && (document.getElementById('live-badge').style.display = 'block');
      setSkullEyes('green');
      hidePlayerSpinner();
    });
    video.addEventListener('error', () => {
      dbgLog('Video error event', '#f00');
    });
  }

  // ── STALKER LIVE CHANNEL PLAYER ──
  // Watch a live channel from a stalker portal hit by opening the player overlay
  // Now uses /api/stalker-channels to fetch actual channel list + stream URLs
  function playStalkerChannel(portalUrl, mac, channelName) {
    const displayUrl = portalUrl; // Keep original for display (shows /c/ not /c)
    const base = portalUrl.replace(/\/+$/, '');
    const displayName = channelName || mac || 'IPTV';

    currentMovieId = null;
    currentIsTV = false;
    currentSource = 'stalker';
    window._returnToMacPortalOnClose = true;

    playerOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    isPlaying = true;
    if (playerPlayBtn) { playerPlayBtn.textContent = '⏸'; playerPlayBtn.title = 'Pause'; }
    isPaused = false;
    // Reset controls visibility
    const skHeader = playerOverlay.querySelector('.player-header');
    if (skHeader) skHeader.style.opacity = '1';
    if (playerControls) playerControls.style.opacity = '1';
    playerOverlay.style.cursor = 'default';
    if (playerTitle) playerTitle.textContent = `📺 ${displayName}`;
    showPlayerSpinner('💀 Connecting to portal...');
    setSkullEyes('red');

    // Hide source tabs for stalker
    const tabs = document.getElementById('player-source-tabs');
    if (tabs) tabs.style.display = 'none';

    // Show URL + MAC at bottom of player for easy copying
    showStalkerUrlMac(displayUrl, mac);

    // Step 1: Try /api/stalker-channels to get actual channel list with stream URLs
    showPlayerSpinner('💀 Fetching channel list...');
    fetch(`/api/stalker-channels?url=${encodeURIComponent(base)}&mac=${encodeURIComponent(mac)}&password=${encodeURIComponent(document.getElementById('stalker-password')?.value||'')}&proxy=${encodeURIComponent(window._stalkerProxyType())}`, {
      signal: AbortSignal.timeout(25000)
    })
    .then(r => r.json())
    .then(data => {
      // Save token for create_link calls
      if (data.token) window._stalkerToken = data.token;
      if (data.channels && data.channels.length > 0) {
        console.log(`[CineVault] Got ${data.channels.length} channels from /api/stalker-channels`);
        setSkullEyes('green');
        showChannelSelector(base, mac, data.channels);
      } else {
        console.warn('[CineVault] No channels from /api/stalker-channels, falling back to iframe');
        fallbackToIframe();
      }
    })
    .catch(err => {
      console.warn('[CineVault] Channel list fetch failed, falling back to iframe:', err);
      fallbackToIframe();
    });

    // ── CHANNEL SELECTOR OVERLAY ──
    // Shows list of channel names with genre filtering; user picks one to play via HLS.js
    function showChannelSelector(portalBaseUrl, portalMac, channels) {
      // Cleanup previous HLS before switching
      const _pv = playerVideoWrap.querySelector('video');
      if (_pv && _pv._hls) { try { _pv._hls.destroy(); } catch {} _pv._hls = null; }
      if (window._sidebarHls) { try { window._sidebarHls.destroy(); } catch {} window._sidebarHls = null; }
      playerVideoWrap.innerHTML = '';
      showPlayerSpinner(`💀 ${channels.length} channels found — pick one below`);

      const selector = document.createElement('div');
      selector.className = 'stalker-channel-selector';
      selector.style.cssText = 'position:absolute;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.95);z-index:10;overflow-y:auto;padding:60px 20px 80px;';

      // Build genre list for filter tabs
      const genreCounts = {};
      for (const ch of channels) {
        const g = ch.genreName || ch.group || 'Other';
        genreCounts[g] = (genreCounts[g] || 0) + 1;
      }
      const sortedGenres = Object.entries(genreCounts).sort((a, b) => b[1] - a[1]);

      const header = document.createElement('div');
      header.style.cssText = 'text-align:center;margin-bottom:12px;';
      header.innerHTML = `
        <div style="font-size:1.2rem;color:#e50914;font-weight:bold;margin-bottom:4px;">📺 ${esc(channels.length)} Channels Available</div>
        <div style="font-size:0.75rem;color:#888;">Portal: ${esc(portalBaseUrl)} | MAC: ${esc(portalMac)}</div>
        <input type="text" placeholder="Search channels..." style="margin-top:8px;padding:8px 12px;width:80%;max-width:400px;border:1px solid #333;background:#111;color:#fff;border-radius:4px;font-size:0.85rem;" id="stalker-ch-search" />
      `;
      selector.appendChild(header);

      // Genre filter tabs
      const tabRow = document.createElement('div');
      tabRow.style.cssText = 'display:flex;flex-wrap:wrap;gap:4px;justify-content:center;margin-bottom:12px;max-height:80px;overflow-y:auto;';
      let activeGenre = 'all';
      const allTab = document.createElement('button');
      allTab.textContent = `All (${channels.length})`;
      allTab.style.cssText = 'padding:4px 10px;background:#e50914;color:#fff;border:none;border-radius:3px;cursor:pointer;font-size:0.75rem;';
      tabRow.appendChild(allTab);
      const genreButtons = { 'all': allTab };
      for (const [genre, count] of sortedGenres.slice(0, 30)) {
        const tab = document.createElement('button');
        tab.textContent = `${genre} (${count})`;
        tab.style.cssText = 'padding:4px 10px;background:#1a1a2e;color:#aaa;border:1px solid #333;border-radius:3px;cursor:pointer;font-size:0.7rem;';
        tab.dataset.genre = genre;
        genreButtons[genre] = tab;
        tabRow.appendChild(tab);
      }
      selector.appendChild(tabRow);

      // Wire tab clicks
      tabRow.addEventListener('click', (e) => {
        const btn = e.target.closest('button');
        if (!btn) return;
        const genre = btn.dataset.genre || 'all';
        activeGenre = genre;
        // Update tab styles
        for (const [g, b] of Object.entries(genreButtons)) {
          b.style.background = g === genre ? '#e50914' : '#1a1a2e';
          b.style.color = g === genre ? '#fff' : '#aaa';
          b.style.border = g === genre ? 'none' : '1px solid #333';
        }
        // Filter channel buttons
        list.querySelectorAll('.stalker-ch-item').forEach(item => {
          const show = genre === 'all' || item.dataset.genre === genre;
          item.style.display = show ? '' : 'none';
        });
      });

      const list = document.createElement('div');
      list.style.cssText = 'display:flex;flex-wrap:wrap;gap:8px;justify-content:center;';

      channels.forEach((ch, idx) => {
        const btn = document.createElement('button');
        const chName = ch.name || ch.title || `Ch ${idx + 1}`;
        const chCmd = ch.cmd || ch.streamUrl || ch.url || '';
        const chGenre = ch.genreName || ch.group || '';
        btn.className = 'stalker-ch-item';
        btn.dataset.cmd = chCmd;
        btn.dataset.name = chName;
        btn.dataset.genre = chGenre;
        btn.dataset.index = idx;
        btn.style.cssText = 'padding:8px 14px;background:#1a1a2e;border:1px solid #333;color:#fff;border-radius:4px;cursor:pointer;font-size:0.8rem;max-width:180px;text-align:center;transition:border-color 0.2s;';
        btn.innerHTML = `<div style="font-weight:bold;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${esc(chName)}</div>${chGenre ? `<div style="font-size:0.65rem;color:#888;margin-top:2px;">${esc(chGenre)}</div>` : ''}`;

        btn.addEventListener('mouseenter', () => { btn.style.borderColor = '#e50914'; });
        btn.addEventListener('mouseleave', () => { btn.style.borderColor = '#333'; });

        btn.addEventListener('click', () => {
          const isVod = ch.item_type === 'vod' || ch.type === 'vod' || ch.type === 'movies' || (chCmd && chCmd.includes('vod'));
          window._stalkerLastChannelId = ch.id || ch.channel_id || ch.number || '';
          // Play via server-side HLS proxy (ffmpeg remux — plays inside portal)
          const hlsUrl = `/api/stalker-hls?url=${encodeURIComponent(portalBaseUrl)}&mac=${encodeURIComponent(portalMac)}&cmd=${encodeURIComponent(chCmd)}&linkType=${isVod ? 'vod' : 'itv'}`;
          showPlayerSpinner(`💀 ${chName} — Tuning...`);
          setSkullEyes('red');
          playStalkerStreamDirect(portalBaseUrl, portalMac, chCmd, chName, isVod ? 'vod' : undefined);
          // Auto-launch VLC — browser HLS skips, VLC plays smooth
          if (window._stalkerLastChannelId) {
            fetch(`/api/vlc-channel/${encodeURIComponent(window._stalkerLastChannelId)}`).then(r=>r.json()).then(d => {
              if (d.success) {
                toast(`${d.channel || chName} → VLC`, 'success');
                const portalVlcSt = document.getElementById('stalker-portal-vlc-status');
                if (portalVlcSt) portalVlcSt.textContent = `▶ ${d.channel || chName}`;
              }
              else toast(d.error || 'VLC failed', 'error');
            }).catch(() => {});
          }
        });
        list.appendChild(btn);
      });

      selector.appendChild(list);
      playerVideoWrap.appendChild(selector);
      playerElement = selector;

      // Wire up search filter
      setTimeout(() => {
        const searchInput = document.getElementById('stalker-ch-search');
        if (searchInput) {
          searchInput.addEventListener('input', () => {
            const q = searchInput.value.toLowerCase();
            list.querySelectorAll('.stalker-ch-item').forEach(btn => {
              const name = btn.dataset.name.toLowerCase();
              const matchesSearch = name.includes(q);
              const matchesGenre = activeGenre === 'all' || btn.dataset.genre === activeGenre;
              btn.style.display = (matchesSearch && matchesGenre) ? '' : 'none';
            });
          });
          searchInput.focus();
        }
      }, 100);

      // After a short moment hide the spinner so selector is visible
      setTimeout(() => hidePlayerSpinner(), 300);
    }

    // ── PLAY STREAM VIA HLS.js ──
    function playStalkerStream(portalBaseUrl, portalMac, channelCmd, channelDisplayName, linkType) {
      showPlayerSpinner(`💀 Loading ${channelDisplayName}...`);
      setSkullEyes('red');
      // Cleanup previous HLS before switching
      const _pv = playerVideoWrap.querySelector('video');
      if (_pv && _pv._hls) { try { _pv._hls.destroy(); } catch {} _pv._hls = null; }
      if (window._sidebarHls) { try { window._sidebarHls.destroy(); } catch {} window._sidebarHls = null; }
      playerVideoWrap.innerHTML = '';

      const video = document.createElement('video');
      video.id = 'live-hls-player';
      video.autoplay = true;
      video.muted = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('x5-video-player-type', 'h5');
      video.setAttribute('x5-video-player-fullscreen', 'false');
      video.style.cssText = 'width:100%;height:100%;background:#000;position:absolute;top:0;left:0;';
      // Hide video until it starts playing — prevents "little box" behind spinner
      video.style.opacity = '0';
      video.style.transition = 'opacity 0.3s ease';
      playerVideoWrap.appendChild(video);
      playerElement = video;

      // ── Debugger Preview Panel ──
      const dbg = document.createElement('div');
      dbg.id = 'stalker-debug-panel';
      dbg.style.cssText = 'position:absolute;bottom:60px;left:10px;max-width:420px;max-height:260px;overflow-y:auto;background:rgba(0,0,0,0.88);border:1px solid #e50914;border-radius:6px;padding:10px 14px;font-size:11px;color:#0f0;z-index:5;font-family:monospace;pointer-events:none;display:none;';
      dbg.innerHTML = `<div style="color:#e50914;font-weight:bold;margin-bottom:4px;">💀 STREAM DEBUGGER</div><div id="dbg-lines"></div>`;
      playerVideoWrap.appendChild(dbg);
      const dbgLines = dbg.querySelector('#dbg-lines');
      function dbgLog(msg, color) {
        if (!dbgLines) return;
        const ts = new Date().toLocaleTimeString();
        const line = document.createElement('div');
        line.style.color = color || '#0f0';
        line.textContent = `[${ts}] ${msg}`;
        dbgLines.appendChild(line);
        dbgLines.scrollTop = dbgLines.scrollHeight;
      }
      dbgLog(`Channel: ${channelDisplayName}`, '#fff');
      dbgLog(`Portal: ${portalBaseUrl}`, '#888');
      dbgLog(`MAC: ${portalMac}`, '#888');
      dbgLog(`Raw cmd: ${channelCmd?.substring(0, 80)}`, '#ff0');

      // Resolve stream URL
      let streamUrl = channelCmd;
      if (streamUrl.startsWith('ffmpeg ')) streamUrl = streamUrl.substring(7);

      // If it's a localhost URL, resolve via server create_link endpoint
      if (streamUrl.includes('localhost') || streamUrl.includes('/ch/')) {
        dbgLog('Resolving localhost URL via create_link...', '#ff0');
        const proxyType = window._stalkerProxyType ? window._stalkerProxyType() : 'server';
        const token = window._stalkerToken || '';
        showPlayerSpinner(`💀 Resolving stream for ${channelDisplayName}...`);
        const ltUrl = linkType ? `&linkType=${encodeURIComponent(linkType)}` : '';
        fetch(`/api/stalker-create-link?url=${encodeURIComponent(portalBaseUrl)}&mac=${encodeURIComponent(portalMac)}&cmd=${encodeURIComponent(channelCmd)}&token=${encodeURIComponent(token)}&proxy=${encodeURIComponent(proxyType)}${ltUrl}`)
          .then(r => r.json())
          .then(data => {
            if (data.streamUrl && (data.streamUrl.startsWith('http://') || data.streamUrl.startsWith('https://'))) {
              dbgLog(`Resolved: ${data.streamUrl.substring(0, 80)}`, '#0f0');
              // CRITICAL: create-link does a fresh handshake — use its token for stalker-stream
              // or the CDN will 401 because the play_token is bound to that handshake session
              if (data.token) { window._stalkerToken = data.token; dbgLog(`Token updated from create-link: ${data.token.substring(0,16)}...`, '#0ff'); }
              loadHlsStream(video, data.streamUrl, channelDisplayName, portalBaseUrl, portalMac);
            } else {
              dbgLog(`Failed to resolve: ${JSON.stringify(data).substring(0, 100)}`, '#f00');
              // Try token-based handshake then retry
              doHandshakeAndRetry();
            }
          })
          .catch(err => {
            dbgLog(`create_link error: ${err.message}`, '#f00');
            doHandshakeAndRetry();
          });

        function doHandshakeAndRetry() {
          dbgLog('Retrying with fresh handshake...', '#ff0');
          const proxyType2 = window._stalkerProxyType ? window._stalkerProxyType() : 'server';
          const stalkerPassword = document.getElementById('stalker-password')?.value || document.getElementById('ma-proxy-input')?.value || '';
          fetch(`/api/stalker-channels?url=${encodeURIComponent(portalBaseUrl)}&mac=${encodeURIComponent(portalMac)}&password=${encodeURIComponent(stalkerPassword)}&proxy=${encodeURIComponent(proxyType2)}`)
            .then(r => r.json())
            .then(data => {
              const newToken = data.token || '';
              window._stalkerToken = newToken;
              dbgLog(`New token: ${newToken ? newToken.substring(0,16)+'...' : 'FAIL'}`, newToken ? '#0f0' : '#f00');
              if (newToken) {
                fetch(`/api/stalker-create-link?url=${encodeURIComponent(portalBaseUrl)}&mac=${encodeURIComponent(portalMac)}&cmd=${encodeURIComponent(channelCmd)}&token=${encodeURIComponent(newToken)}&proxy=${encodeURIComponent(proxyType2)}${ltUrl}`)
                  .then(r2 => r2.json())
                  .then(data2 => {
                    if (data2.streamUrl) {
                      dbgLog(`Resolved (retry): ${data2.streamUrl.substring(0, 80)}`, '#0f0');
                      // Update token from create-link response (same session that issued play_token)
                      if (data2.token) { window._stalkerToken = data2.token; dbgLog(`Token updated (retry): ${data2.token.substring(0,16)}...`, '#0ff'); }
                      loadHlsStream(video, data2.streamUrl, channelDisplayName, portalBaseUrl, portalMac);
                    } else {
                      dbgLog('Final resolve failed — black screen', '#f00');
                      hidePlayerSpinner();
                    }
                  })
                  .catch(err2 => { dbgLog(`Retry error: ${err2.message}`, '#f00'); hidePlayerSpinner(); });
              } else {
                dbgLog('No token — cannot resolve', '#f00');
                hidePlayerSpinner();
              }
            })
            .catch(err => { dbgLog(`Handshake error: ${err.message}`, '#f00'); hidePlayerSpinner(); });
        }
      } else if (streamUrl.startsWith('http://') || streamUrl.startsWith('https://')) {
        dbgLog(`Direct URL — playing`, '#0f0');
        loadHlsStream(video, streamUrl, channelDisplayName, portalBaseUrl, portalMac);
      } else {
        dbgLog(`Cannot parse cmd: ${streamUrl?.substring(0,60)}`, '#f00');
        // Needs create_link — try server-side resolution via StalkerScanner
        if (typeof StalkerScanner !== 'undefined' && StalkerScanner.getStreamUrl) {
          StalkerScanner.getStreamUrl(portalBaseUrl, portalMac, channelCmd).then(resolvedUrl => {
            dbgLog(`StalkerScanner resolved: ${resolvedUrl?.substring(0,80)}`, '#0f0');
            loadHlsStream(video, resolvedUrl, channelDisplayName, portalBaseUrl, portalMac);
          }).catch(() => {
            // Fallback to iframe
            fallbackToIframe();
          });
        } else {
          // Fallback: try /api/stalker-channels with cmd param
          fetch(`/api/stalker-channels?url=${encodeURIComponent(portalBaseUrl)}&mac=${encodeURIComponent(portalMac)}&cmd=${encodeURIComponent(channelCmd)}&proxy=${encodeURIComponent(window._stalkerProxyType())}&password=${encodeURIComponent(document.getElementById('stalker-password')?.value||'')}`, {
            signal: AbortSignal.timeout(10000)
          })
          .then(r => r.json())
          .then(data => {
            const url = data.streamUrl || data.cmd || channelCmd;
            loadHlsStream(video, url, channelDisplayName, portalBaseUrl, portalMac);
          })
          .catch(() => {
            fallbackToIframe();
          });
        }
      }

      // ── HLS STREAM LOADER ──
    function showUnmuteOverlay(videoEl, liveBadge) {
      // Remove any existing overlay
      const existing = document.getElementById('unmute-overlay');
      if (existing) existing.remove();
      const overlay = document.createElement('div');
      overlay.id = 'unmute-overlay';
      overlay.style.cssText = 'position:absolute;top:0;left:0;right:0;bottom:0;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,0.4);cursor:pointer;z-index:20;transition:opacity 0.3s ease;';
      overlay.innerHTML = '<div style="background:rgba(229,9,20,0.9);color:#fff;padding:14px 28px;border-radius:12px;font-size:18px;font-weight:600;display:flex;align-items:center;gap:10px;box-shadow:0 4px 20px rgba(0,0,0,0.5);pointer-events:none;">🔊 Tap to Unmute</div>';
      overlay.addEventListener('click', () => {
        videoEl.muted = false;
        videoEl.volume = 1;
        try { videoEl.play(); } catch {}
        overlay.style.opacity = '0';
        setTimeout(() => { if (overlay.parentNode) overlay.remove(); }, 300);
      });
      playerVideoWrap.appendChild(overlay);
      // Auto-hide after 10s
      setTimeout(() => {
        if (document.getElementById('unmute-overlay')) {
          overlay.style.opacity = '0';
          setTimeout(() => { if (overlay.parentNode) overlay.remove(); }, 300);
        }
      }, 10000);
    }

    function loadHlsStream(videoEl, streamUrl, channelName, portalBaseUrl, portalMac) {
      if (!streamUrl || (!streamUrl.startsWith('http://') && !streamUrl.startsWith('https://'))) {
        dbgLog(`Invalid stream URL: ${streamUrl?.substring(0,60)}`, '#f00');
        fallbackToIframe();
        return;
      }

      // Strip ffmpeg prefix just in case
      if (streamUrl.startsWith('ffmpeg ')) streamUrl = streamUrl.substring(7);
      dbgLog(`Loading stream: ${streamUrl.substring(0,80)}`, '#0f0');

      // Detect stream type BEFORE proxy rewrite (need original URL to check extensions)
      // CDN stalker streams are MPEG-TS (.ts) which browsers can't play natively.
      // They MUST go through HLS.js even without .m3u8 extension.
      const isHLS = streamUrl.includes('.m3u8') || streamUrl.includes('m3u8');
      const isStalkerStream = streamUrl.includes('cdnip') || streamUrl.includes('play_token') || streamUrl.includes('/ch/');
      const isDirect = !isHLS && !isStalkerStream && (streamUrl.includes('.mp4') || streamUrl.includes('.ts') || streamUrl.includes('.mkv'));

      // Route through server-side proxy with header injection
      // Stalker streams → /api/stalker-stream (MAG200 auth cookies)
      // HEVC/H.265 streams → /api/transcode/master.m3u8 (ffmpeg → H.264)
      // Regular HLS → /api/hls-proxy (injects User-Agent, Referer, Origin)
      const stalkerToken = window._stalkerToken || '';
      const originalStreamUrl = streamUrl;
      if (portalMac) {
        streamUrl = `/api/stalker-stream?url=${encodeURIComponent(streamUrl)}&mac=${encodeURIComponent(portalMac)}&token=${encodeURIComponent(stalkerToken)}&portal=${encodeURIComponent(portalBaseUrl || '')}`;
        dbgLog(`Stalker stream → proxy: ${streamUrl.substring(0,80)}`, '#0f0');
      } else if (isHLS || isStalkerStream) {
        streamUrl = `/api/hls-proxy?url=${encodeURIComponent(streamUrl)}`;
        dbgLog(`HLS stream → proxy: ${streamUrl.substring(0,80)}`, '#0f0');
      }

      // Add LIVE badge to player
      const liveBadge = document.createElement('div');
      liveBadge.id = 'live-badge';
      liveBadge.style.cssText = 'position:absolute;top:12px;right:12px;background:#e50914;color:#fff;font-size:0.7rem;font-weight:bold;padding:3px 8px;border-radius:3px;z-index:15;animation:blink 1.5s infinite;display:none;';
      liveBadge.textContent = '🔴 LIVE';
      playerVideoWrap.appendChild(liveBadge);

      // Add time display for debugging
      const timeDisplay = document.createElement('div');
      timeDisplay.id = 'stream-debug-time';
      timeDisplay.style.cssText = 'position:absolute;top:12px;left:12px;background:rgba(0,0,0,0.7);color:#0f0;font-size:0.65rem;font-family:monospace;padding:4px 8px;border-radius:4px;z-index:15;display:none;';
      playerVideoWrap.appendChild(timeDisplay);

      // Update time display every second
      const timeInterval = setInterval(() => {
        if (!videoEl) { clearInterval(timeInterval); return; }
        const ct = videoEl.currentTime || 0;
        const dur = videoEl.duration || 0;
        const ready = videoEl.readyState;
        const paused = videoEl.paused;
        const net = videoEl.networkState;
        const stateMap = {0:'EMPTY',1:'IDLE',2:'LOADING',3:'NO_SOURCE'};
        if (timeDisplay) {
          timeDisplay.style.display = 'block';
          timeDisplay.textContent = `▶ ${formatTime(ct)}/${isFinite(dur)?formatTime(dur):'LIVE'} rdy=${ready} ${paused?'⏸':'▶'} net=${stateMap[net]||net}`;
        }
      }, 1000);

      // Stalker CDN streams with play_token are continuous MPEG-TS — NOT HLS.
      // HLS.js expects m3u8 playlists and will fail on raw MPEG-TS.
      // Use direct video.src for MPEG-TS, HLS.js only for actual .m3u8 streams.
      const needsHlsJs = isHLS && typeof Hls !== 'undefined' && Hls.isSupported();
      const needsDirectStream = isStalkerStream && !isHLS;

      if (needsHlsJs) {
        dbgLog(isHLS ? 'HLS stream detected — using HLS.js' : 'Stalker MPEG-TS stream — using HLS.js', '#0f0');
        const hlsCfg = makeStableHlsConfig();
        hlsCfg.fragLoadingMaxRetry = 6;
        // Inject required headers on every XHR (manifest + segments)
        hlsCfg.xhrSetup = function(xhr, url) {
          xhr.setRequestHeader('User-Agent', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36');
          xhr.setRequestHeader('Referer', window.location.origin);
          xhr.setRequestHeader('Origin', window.location.origin);
          xhr.withCredentials = false;
        };
        const hls = new Hls(hlsCfg);
        hls.loadSource(streamUrl);
        hls.attachMedia(videoEl);

        hls.on(Hls.Events.MANIFEST_PARSED, () => {
          dbgLog('HLS manifest parsed — playing', '#0f0');
          forceBestHlsQuality(hls, channelName);
          // Try unmuted first; fall back to muted if browser blocks autoplay
          videoEl.muted = false;
          videoEl.volume = 1;
          videoEl.play().catch(e => {
            dbgLog(`Unmuted play blocked: ${e.message} — retrying muted`, '#ff0');
            videoEl.muted = true;
            videoEl.play().catch(e2 => dbgLog(`Muted play also failed: ${e2.message}`, '#f00'));
            // Show unmute overlay so user can enable sound
            showUnmuteOverlay(videoEl, liveBadge);
          });
          // Also force play on canplay/loadeddata for strict browsers (FireDragon/Floorp)
          const forceMutedPlay = () => {
            if (videoEl.paused) {
              dbgLog('Force-muted play retry on readiness event', '#ff0');
              videoEl.muted = true;
              videoEl.play().catch(() => {});
            }
          };
          videoEl.addEventListener('canplay', forceMutedPlay, { once: true });
          videoEl.addEventListener('loadeddata', forceMutedPlay, { once: true });
          // Fade video in and hide spinner
          videoEl.style.opacity = '1';
          hidePlayerSpinner();
          setSkullEyes('green');
          setSkullConnected(channelName);
          liveBadge.style.display = 'block';
          if (typeof StalkerScanner !== 'undefined') {
            try { StalkerScanner.macAttackAlertSound && StalkerScanner.macAttackAlertSound(); } catch {}
          }
        });

        hls.on(Hls.Events.FRAG_LOADED, () => {
          dbgLog('HLS fragment loaded', '#0f0');
        });

        hls.on(Hls.Events.ERROR, (event, data) => {
          dbgLog(`HLS error: ${data.type} ${data.details}`, data.fatal ? '#f00' : '#ff0');
          // Auto-retry through ffmpeg transcoder on codec errors (HEVC/H.265)
          if (data.details === 'BUFFER_INCOMPATIBLE_CODECS' || data.details === 'FRAG_PARSING_ERROR' || (data.type === Hls.ErrorTypes.MEDIA_ERROR && originalStreamUrl && !originalStreamUrl.includes('/api/transcode'))) {
            dbgLog('Codec error detected — retrying through transcoder...', '#ff0');
            hls.destroy();
            const transcodeUrl = `/api/transcode/master.m3u8?url=${encodeURIComponent(originalStreamUrl)}`;
            dbgLog(`Transcode URL: ${transcodeUrl.substring(0,100)}`, '#0ff');
            const hls2Cfg = makeStableHlsConfig();
            hls2Cfg.fragLoadingMaxRetry = 6;
            hls2Cfg.xhrSetup = function(xhr, url) {
              xhr.setRequestHeader('User-Agent', 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36');
              xhr.setRequestHeader('Referer', window.location.origin);
              xhr.setRequestHeader('Origin', window.location.origin);
              xhr.withCredentials = false;
            };
            const hls2 = new Hls(hls2Cfg);
            hls2.loadSource(transcodeUrl);
            hls2.attachMedia(videoEl);
            hls2.on(Hls.Events.MANIFEST_PARSED, () => {
              dbgLog('Transcoded stream — playing H.264', '#0f0');
              forceBestHlsQuality(hls2, channelName);
              videoEl.muted = false;
              videoEl.volume = 1;
              videoEl.play().catch(e => {
                dbgLog(`transcode play() blocked: ${e.message} — retrying muted`, '#ff0');
                videoEl.muted = true;
                videoEl.play().catch(() => {});
                showUnmuteOverlay(videoEl, liveBadge);
              });
              hidePlayerSpinner();
              setSkullEyes('green');
              setSkullConnected(channelName);
            });
            hls2.on(Hls.Events.ERROR, (e2, d2) => {
              dbgLog(`Transcode HLS error: ${d2.type} ${d2.details}`, d2.fatal ? '#f00' : '#ff0');
              if (d2.fatal) {
                switch(d2.type) {
                  case Hls.ErrorTypes.NETWORK_ERROR:
                    dbgLog('Transcode network error — retrying...', '#ff0');
                    hls2.startLoad();
                    break;
                  case Hls.ErrorTypes.MEDIA_ERROR:
                    dbgLog('Transcode media error — recovering...', '#ff0');
                    hls2.recoverMediaError();
                    break;
                  default:
                    dbgLog('Transcode fatal error — trying direct play', '#f00');
                    tryDirectPlay();
                    break;
                }
              }
            });
            videoEl._hls = hls2;
            return;
          }
          if (data.fatal) {
            switch(data.type) {
              case Hls.ErrorTypes.NETWORK_ERROR:
                dbgLog('Network error — retrying...', '#ff0');
                hls.startLoad();
                break;
              case Hls.ErrorTypes.MEDIA_ERROR:
                dbgLog('Media error — recovering...', '#ff0');
                hls.recoverMediaError();
                break;
              default:
                // Try native playback
                dbgLog('Fatal HLS error — trying direct play', '#f00');
                tryDirectPlay();
                break;
            }
          }
        });
        videoEl._hls = hls;

      } else {
        // Direct play — MP4, TS, or octet-stream from stalker portals
        dbgLog(isHLS ? 'HLS native (Safari)' : 'Direct stream — setting video.src', '#0f0');
        tryDirectPlay();
      }

      function tryDirectPlay() {
        videoEl.muted = false;
        videoEl.volume = 1;
        videoEl.src = streamUrl;
        videoEl.load();

        videoEl.addEventListener('loadeddata', () => {
          dbgLog(`Stream loaded — playing (readyState=${videoEl.readyState})`, '#0f0');
          videoEl.play().catch(e => {
            dbgLog(`Autoplay blocked — muting: ${e.message}`, '#ff0');
            videoEl.muted = true;
            videoEl.play().catch(e2 => dbgLog(`Still can't play: ${e2.message}`, '#f00'));
            showUnmuteOverlay(videoEl, liveBadge);
          });
          // Fade video in and hide spinner
          videoEl.style.opacity = '1';
          hidePlayerSpinner();
          setSkullEyes('green');
          setSkullConnected(channelName);
          liveBadge.style.display = 'block';
          if (typeof StalkerScanner !== 'undefined') {
            try { StalkerScanner.macAttackAlertSound && StalkerScanner.macAttackAlertSound(); } catch {}
          }
        }, { once: true });

        videoEl.addEventListener('canplay', () => {
          dbgLog('canplay event — stream ready', '#0f0');
          if (videoEl.paused) {
            videoEl.play().catch(() => {});
          }
        }, { once: true });

        videoEl.addEventListener('playing', () => {
          dbgLog('PLAYING — stream active!', '#0f0');
          liveBadge.style.display = 'block';
          videoEl.style.opacity = '1';
          dbg.style.display = 'block';
        }, { once: true });

        videoEl.addEventListener('waiting', () => {
          dbgLog('Buffering...', '#ff0');
        });

        videoEl.addEventListener('error', (e) => {
          dbgLog(`Video error: ${videoEl.error?.code} ${videoEl.error?.message}`, '#f00');
          // Try HLS.js as fallback if we haven't yet
          if (!isHLS && typeof Hls !== 'undefined' && Hls.isSupported() && !videoEl._hls) {
            dbgLog('Direct play failed — trying HLS.js', '#ff0');
            const hls = new Hls(makeStableHlsConfig());
            hls.loadSource(streamUrl);
            hls.attachMedia(videoEl);
            hls.on(Hls.Events.MANIFEST_PARSED, () => {
              forceBestHlsQuality(hls, channelName);
              videoEl.play().catch(() => {});
              hidePlayerSpinner();
              setSkullEyes('green');
              liveBadge.style.display = 'block';
            });
            hls.on(Hls.Events.ERROR, (_, d) => {
              if (d.fatal) {
                switch(d.type) {
                  case Hls.ErrorTypes.NETWORK_ERROR:
                    dbgLog('HLS fallback network error — retrying...', '#ff0');
                    hls.startLoad();
                    break;
                  case Hls.ErrorTypes.MEDIA_ERROR:
                    dbgLog('HLS fallback media error — recovering...', '#ff0');
                    hls.recoverMediaError();
                    break;
                  default:
                    dbgLog('HLS fallback also failed', '#f00');
                    hls.destroy();
                    fallbackToIframe();
                    break;
                }
              }
            });
            videoEl._hls = hls;
          }
        }, { once: true });

        // Timeout — if nothing plays in 10s, try iframe
        setTimeout(() => {
          if (videoEl.readyState === 0 && !videoEl._hls) {
            dbgLog('10s timeout — no data received', '#f00');
          }
        }, 10000);
