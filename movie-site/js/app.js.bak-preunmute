  // ── SERVEO TUNNEL STATUS + AUTO-UPDATE ──
  let _serveoUrl = null;
  let _lastServeoSubdomain = null;

  async function refreshServeoTunnel() {
    try {
      const r = await origFetch('/api/tunnel-url');
      const d = await r.json();
      const el = document.getElementById('bore-url-text');
      const bar = document.getElementById('bore-tunnel-bar');
      if (d.status === 'active' && d.url) {
        const newUrl = d.url;
        const newSubdomain = newUrl.match(/https?:\/\/([^.]+)\./)?.[1] || null;

        if (el) el.textContent = '🔗 ' + newUrl;
        if (bar) bar.style.background = 'rgba(0,255,65,0.08)';

        // Detect subdomain change and notify
        if (_lastServeoSubdomain && _lastServeoSubdomain !== newSubdomain) {
          if (typeof dbgLog === 'function') dbgLog(`[TUNNEL] Serveo subdomain changed: ${_lastServeoSubdomain} → ${newSubdomain}`, '#ff9100');
          if (typeof toast === 'function') toast(`⚠️ Tunnel URL changed! New: ${newUrl}`, 15000);
          if (bar) bar.style.background = 'rgba(255,145,0,0.12)';
        }

        _serveoUrl = newUrl;
        _lastServeoSubdomain = newSubdomain;
      } else {
        if (el) el.textContent = '⚠️ Tunnel offline';
        if (bar) bar.style.background = 'rgba(255,65,0,0.08)';
      }
    } catch(e) {
      const el = document.getElementById('bore-url-text');
      if (el) el.textContent = '⚠️ Tunnel unknown';
    }
  }
  window.copyTunnelUrl = function() {
