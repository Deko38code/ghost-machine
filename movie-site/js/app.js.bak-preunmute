	        more.textContent = `Show more (${maPlaylistRenderState.shown.toLocaleString()} / ${items.length.toLocaleString()})`;
	        more.addEventListener('click', () => renderMaPlaylistChunk(false));
	        maPlaylistGrid.appendChild(more);
