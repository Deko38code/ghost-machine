    entries.slice(0, 4).forEach(loadEntry);
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(items => {
        items.forEach(item => {
          if (!item.isIntersecting) return;
          const found = entries.find(([sectionId]) => sectionId === item.target.id);
          if (found) {
            loadEntry(found);
            observer.unobserve(item.target);
          }
        });
      }, { rootMargin: '600px' });
      entries.slice(4).forEach(([sectionId]) => {
        const section = document.getElementById(sectionId);
        if (section) observer.observe(section);
      });
    } else {
      setTimeout(() => entries.slice(4, 10).forEach(loadEntry), 2000);
