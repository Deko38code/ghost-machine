  let currentSource = 'videasy';
  let sourceTimeout = null;
  const SOURCE_ORDER = ['vidsrcme','videasy','vidbinge','vidsrcpm','vidsrc2','vidsrcsu','embedrev','flicky','vidlink','smashy','multiembed','embed2','embed2skin','playmogo','portal'];

  function getSourceUrl(sourceKey, movieId, season, episode) {
    const src = typeof STREAM_SOURCES !== 'undefined' ? STREAM_SOURCES[sourceKey] : null;
    if (!src) return null;
    // Build ids object: prefer imdbId from currentMovieData or currentImdbId for reliable source resolution
    const imdbId = currentMovieData?.imdb_id || currentImdbId || getImdbId(movieId) || null;
    // CRITICAL: tmdbId MUST be a numeric TMDB ID, never a tt-prefixed IMDB ID.
    // If movieId is an IMDB-style ID (tt...), look up the real TMDB number from movie data or reverse map.
    let numericTmdbId = movieId;
    if (/^tt\d+$/i.test(String(movieId))) {
      // movieId is an IMDB ID — resolve the real numeric TMDB ID
      numericTmdbId = currentMovieData?.id || null;
      if (!numericTmdbId || /^tt\d+$/i.test(String(numericTmdbId))) {
        // Still no numeric ID — try TMDB_TO_IMDB reverse lookup
        numericTmdbId = IMDB_TO_TMDB[String(movieId)] || null;
      }
      if (!numericTmdbId) {
        // Last resort: strip tt prefix and use numeric part (may be wrong but better than tt-prefix)
        numericTmdbId = parseInt(String(movieId).replace(/^tt/i, ''), 10) || movieId;
      }
    }
    const ids = { tmdbId: numericTmdbId, imdbId };
    // TV shows: always use TV URL, defaulting to S1E1 if no season/episode specified
    if (currentIsTV) {
      const s = season || 1;
      const e = episode || 1;
      return src.tv ? src.tv(ids, s, e) : src.movie(ids);
    }
    if (season && episode) return src.tv(ids, season, episode);
    return src.movie(ids);
  }

