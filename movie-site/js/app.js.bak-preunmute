  async function loadStalkerChannels(host, mac) {
    const btn = document.getElementById('stalker-load-btn');
    const countEl = document.getElementById('stalker-channel-count');
    if (btn) { btn.disabled = true; btn.textContent = '⏳ Loading...'; }

    try {
      const rawHost = String(host || '').trim();
      const url = /^https?:\/\//i.test(rawHost) ? rawHost : `http://${rawHost}`;
      const displayHost = url.replace(/^https?:\/\//i, '').replace(/\/+$/, '');
      const res = await fetch('/api/macaction/get-playlist', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ host: url, mac, proxy: 'server', limit: 160000 }),
        signal: AbortSignal.timeout(120000)
      });
      if (!res.ok) throw new Error('Failed: ' + res.status);
      const data = await res.json();
      if (data.error || data.ok === false) throw new Error(data.error || 'Playlist failed');
      _stalkerChannels = (data.channels || []).sort((a, b) => {
        // Server already sorts US-first, but re-sort here for any client-fetch path
        const isUS = /(^|[^a-z0-9])(united\s*states|usa|u\.s\.a\.?|u\.s\.|us|american)([^a-z0-9]|$)/i;
        const aUS = isUS.test(a.genreName || a.group || a.name || '') ? 0 : 1;
        const bUS = isUS.test(b.genreName || b.group || b.name || '') ? 0 : 1;
        if (aUS !== bUS) return aUS - bUS;
        if ((b.open || 0) !== (a.open || 0)) return (b.open || 0) - (a.open || 0);
        return (a.number || 0) - (b.number || 0);
      });
      const genreNames = [...new Set(_stalkerChannels.map(ch => ch.genreName || ch.group || '').filter(Boolean))];
      // Sort genres: US first, then alphabetical
      const isUSGenre = /(^|[^a-z0-9])(united\s*states|usa|u\.s\.a\.?|u\.s\.|us|american)([^a-z0-9]|$)/i;
      genreNames.sort((a, b) => {
        const aUS = isUSGenre.test(a) ? 0 : 1;
        const bUS = isUSGenre.test(b) ? 0 : 1;
        if (aUS !== bUS) return aUS - bUS;
        return a.localeCompare(b);
      });
      _stalkerGenres = genreNames.map((name, idx) => ({ id: name || String(idx + 1), title: name || 'Other' }));

      // Build genre map
      _stalkerGenreMap = {};
      _stalkerChannels.forEach(ch => {
        const gid = String(ch.genreName || ch.group || ch.genreId || ch.cat_id || 'uncategorized');
        if (!_stalkerGenreMap[gid]) _stalkerGenreMap[gid] = [];
        _stalkerGenreMap[gid].push(ch);
      });

      if (countEl) countEl.textContent = _stalkerChannels.length + ' channels';

      // Update source bar display
      const hostEl = document.getElementById('stalker-source-host');
      const macEl = document.getElementById('stalker-source-mac');
      if (hostEl) hostEl.textContent = displayHost;
      if (macEl) macEl.textContent = mac;
      const maHostInput = document.getElementById('ma-host-input');
      const maMacInput = document.getElementById('ma-mac-input');
      if (maHostInput) maHostInput.value = url;
      if (maMacInput) maMacInput.value = mac;
      const livePortalHostInput = document.getElementById('livetv-portal-host-input');
      const livePortalMacInput = document.getElementById('livetv-portal-mac-input');
      if (livePortalHostInput) livePortalHostInput.value = url;
      if (livePortalMacInput) livePortalMacInput.value = mac;

      activePortal = {
        url,
        mac,
        channels: _stalkerChannels,
        genres: _stalkerGenres,
        portalType: data.token ? 'Stalker Portal' : 'Portal',
        channelCount: data.total || data.channelCount || _stalkerChannels.length
      };
      showPlaylistChannels(activePortal);
      renderLivePortalSidebar(url, mac);

      // Save to localStorage for persistence
      localStorage.setItem('cinevault_stalker_channels', JSON.stringify({ host, mac, count: _stalkerChannels.length, ts: Date.now() }));

      toast(`💀 Loaded ${(data.total || _stalkerChannels.length).toLocaleString()} channels from portal!`, 'success');
      renderLiveTV();

      // Show VLC button in portal bar now that channels are loaded
      const portalVlcBtn = document.getElementById('stalker-portal-vlc-btn');
      if (portalVlcBtn) portalVlcBtn.style.display = '';
    } catch (e) {
      toast('💀 Failed to load channels: ' + e.message, 'error');
      if (countEl) countEl.textContent = 'Error';
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = '🔄 Load Channels'; }
    }
  }

