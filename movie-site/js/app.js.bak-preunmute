    const title = document.getElementById('iptv-channels-title');
    const empty = document.getElementById('iptv-empty');

    if (btn) { btn.disabled = true; btn.textContent = '⏳ Loading...'; }
    if (loading) loading.style.display = '';
    if (grid) grid.innerHTML = '';
    if (empty) empty.style.display = 'none';

    try {
      const res = await fetch(`/api/iptv-org?category=${encodeURIComponent(apiCategory)}`);
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();

      const raw = selectedCategory === 'us-english'
        ? filterMostUsEnglishChannels(data.channels || [])
        : (data.channels || []);
      // Dedup by name (case-insensitive) — keep first occurrence
      const seen = new Set();
      _iptvChannels = raw.filter(ch => {
        const key = (ch.name || '').toLowerCase().trim();
        if (seen.has(key)) return false;
        seen.add(key);
        return true;
      });
      _iptvCategories = data.categories || [];

      if (countEl) countEl.textContent = `${_iptvChannels.length} channels`;
      if (title) title.style.display = '';

      renderIptvGrid(_iptvChannels);
      console.log(`[IPTV-ORG] Loaded ${_iptvChannels.length} ${selectedCategory} channels`);
    } catch (e) {
      console.log(`[IPTV-ORG] Load failed: ${e.message}`);
      if (empty) { empty.style.display = ''; empty.textContent = `Failed: ${e.message}`; }
    } finally {
      if (loading) loading.style.display = 'none';
      if (btn) { btn.disabled = false; btn.textContent = '📡 Load iptv-org'; }
    }
  }

