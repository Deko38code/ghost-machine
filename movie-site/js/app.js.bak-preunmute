    isPlaying = false;
    isPaused = false;
    if (playerPlayBtn) { playerPlayBtn.textContent = '▶'; playerPlayBtn.title = 'Play'; }
    if (playerOverlay) playerOverlay.style.cursor = 'default';
    // ── UNFREEZE PAGE: Restore backdrop-filters and animations ──
    document.querySelectorAll('nav, main, header, footer, section, .content, .row, .movie-card, .movie-row, .hero, .card-overlay-btn, .vote-btn, .scroll-btn, .btn, .genre-btn, .section-header, .toast').forEach(el => {
