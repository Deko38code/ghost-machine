    function appendMaScanOutput(line, color = '#cfe') {
      if (!maOutputEl) return;
      const text = String(line || '');
      if (!text) return;
      if (maOutputEl.textContent.trim() === 'Results will appear here.') maOutputEl.textContent = '';
      const div = document.createElement('div');
      div.style.color = color;
      div.textContent = text;
      maOutputEl.appendChild(div);
      while (maOutputEl.children.length > 1200) maOutputEl.removeChild(maOutputEl.firstChild);
      maOutputEl.scrollTop = maOutputEl.scrollHeight;
    }

    if (maStartBtn) {
      maStartBtn.addEventListener('click', async () => {
        // Auto-populate from saved config if input is empty
        if (maIptvInput && !maIptvInput.value.trim()) {
          try {
            const savedCfg = await fetch('/api/macaction/config').then(r => r.json()).catch(() => ({}));
            if (savedCfg.url) maIptvInput.value = savedCfg.url;
          } catch {}
        }
        if (!maIptvInput || !maIptvInput.value.trim()) {
          toast('⚠️ Enter an IPTV link first', 'error'); return;
        }
        setMaDebug('scanner', 'preparing scan request', 'none');
        // Scanner runs server-side now, no need to check MacAttack.pyw status
        maStartBtn.disabled = true; maStartBtn.style.opacity = '0.5'; maStartBtn.style.cursor = 'not-allowed';
        maStartBtn.textContent = '⏳ Scanning...';
        if (maStopBtn) { maStopBtn.disabled = false; maStopBtn.style.opacity = '1'; maStopBtn.style.cursor = 'pointer'; }
        if (maCurrentMacEl) maCurrentMacEl.textContent = '';
        try {
          const maProxyList = document.getElementById('ma-proxy-list');
          const maProxyEnabled = document.getElementById('ma-proxy-enabled');
          const proxyList = (maProxyEnabled && maProxyEnabled.checked && maProxyList) ? maProxyList.value.trim() : '';
          const res = await fetch('/api/macaction/scan', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              url: maIptvInput.value.trim(),
              type: maTypeSelect ? maTypeSelect.value : 'Autodetect',
              prefix: maPrefixSelect ? maPrefixSelect.value : '00:1A:79:',
              speed: maSpeedSlider ? parseInt(maSpeedSlider.value) : 10,
