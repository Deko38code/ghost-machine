	    async function testMacAttackProxies({ silent = false } = {}) {
	      const proxyText = maProxyListEl?.value || '';
	      if (!proxyText.trim()) {
	        if (!silent) toast('⚠️ No proxies to test', 'error');
	        return [];
	      }
	      const proxies = proxyText.split(/\r?\n/).map(l => l.trim()).filter(Boolean);
	      buildProxyGrid(proxies);
	      if (maTestProxiesBtn && !silent) {
	        maTestProxiesBtn.disabled = true;
	        maTestProxiesBtn.textContent = '⏳ Testing...';
	      }
	      if (maProxyOutputEl) maProxyOutputEl.textContent = '';
	      appendMaProxyTerminal(`[PROXY] Testing ${proxies.length} proxies against ${(maHostInput?.value || 'http://evilvir.us.streamtv.to:8080/c/').trim()}`, '#7bd4ff');
	      const workingList = [];
	      try {
	        const resp = await fetch('/api/macaction/test-proxies', {
	          method: 'POST',
	          headers: { 'Content-Type': 'application/json' },
	          body: JSON.stringify({
	            proxies: proxyText,
	            target: (maHostInput?.value || 'http://evilvir.us.streamtv.to:8080/c/').trim()
	          })
	        });
	        if (!resp.body) {
	          const data = await resp.json();
	          throw new Error(data.error || 'Proxy test failed');
	        }
	        const reader = resp.body.getReader();
	        const decoder = new TextDecoder();
	        let buffer = '';
	        while (true) {
	          const { done, value } = await reader.read();
	          if (done) break;
	          buffer += decoder.decode(value, { stream: true });
	          const lines = buffer.split('\n\n');
	          buffer = lines.pop() || '';
	          for (const line of lines) {
	            const m = line.match(/^data: (.+)$/m);
	            if (!m) continue;
	            try {
	              const d = JSON.parse(m[1]);
	              if (d.done) {
	                appendMaProxyTerminal(`[PROXY] Done: ${d.working} working, ${d.failed} failed out of ${d.total}${d.timeout ? ' (timeout cap reached)' : ''}`, d.working ? '#00ff64' : '#ffd166');
	                if (d.workingList?.length) workingList.splice(0, workingList.length, ...d.workingList);
	              } else {
	                const pIdx = proxies.indexOf(d.proxy);
	                if (pIdx >= 0) updateProxyDot(pIdx, d.ok);
	                if (d.ok) workingList.push(d.proxy);
	                appendMaProxyTerminal(d.ok ? `[PROXY] ${d.proxy} working` : `[PROXY] ${d.proxy} failed`, d.ok ? '#00ff64' : '#ff6666');
	              }
	            } catch {}
	          }
	        }
	        if (workingList.length && maProxyListEl) {
	          maProxyListEl.value = [...new Set(workingList)].join('\n');
	          saveMacAttackSetting(maProxyListEl);
	          updateProxyCount();
	        }
	      } catch (e) {
	        if (!silent) toast('⚠️ ' + (e.message || 'Server error'), 'error');
	      } finally {
	        if (maTestProxiesBtn && !silent) {
	          maTestProxiesBtn.disabled = false;
	          maTestProxiesBtn.textContent = '🧪 Test Proxies';
	        }
	      }
	      return [...new Set(workingList)];
	    }

