  function filterMostUsEnglishChannels(channels) {
    const blockedText = /\b(latino|latina|spanish|espanol|español|french|francais|français|arabic|persian|russian|chinese|mandarin|korean|vietnamese|hindi|punjabi|portuguese|brazil|brasil|japanese|german|italian|greek|turkish|polish|ukrainian|haitian|african|africa|religious|christian|islam|muslim|bible|church|praise|proclaim|worship|catholic|3abn|shop|shopping|qvc|hsn)\b/i;
    const preferredGroups = /\b(news|movies|sports|entertainment|comedy|kids|lifestyle|documentary|business|weather|outdoor|auto|food|travel|local|classic|family|music)\b/i;

    const filtered = channels.filter(ch => {
      const text = `${ch.name || ''} ${ch.group || ''} ${ch.tvgId || ''}`;
      if (!/\.us(@|$)/i.test(ch.tvgId || '') && !/\b(us|usa|america|american)\b/i.test(text)) return false;
      if (blockedText.test(text)) return false;
      return preferredGroups.test(ch.group || '') || preferredGroups.test(ch.name || '');
    });

    return filtered.sort((a, b) => {
      const score = ch => {
        const text = `${ch.name || ''} ${ch.group || ''}`.toLowerCase();
        let n = 0;
        if (/\b(news|local|weather)\b/.test(text)) n += 40;
        if (/\b(movies|entertainment|comedy)\b/.test(text)) n += 30;
        if (/\b(sports)\b/.test(text)) n += 25;
        if (/\b(kids|family|lifestyle|documentary)\b/.test(text)) n += 15;
        if (/\(720p\)|\(1080p\)|hd\b/.test(text)) n += 5;
        return n;
      };
      return score(b) - score(a) || String(a.name || '').localeCompare(String(b.name || ''));
    });
  }

