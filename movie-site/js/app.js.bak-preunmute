                  hitList.prepend(entry);
                  hitList.scrollTop = 0;
                }
                // Also update output log with channel count and stream status
                // Build output line based on Output settings checkboxes
                const outLog = document.getElementById('wd-macattack-output');
                if (outLog) {
                  const ck = (id) => document.getElementById(id)?.checked;
                  const parts = ['✅ HIT:'];
                  if (ck('ma-cfg-out-mac')) parts.push(d.mac);
                  if (ck('ma-cfg-out-password') && d.token) parts.push(`token:${d.token}`);
                  if (ck('ma-cfg-out-username') && d.account?.username) parts.push(`user:${d.account.username}`);
                  if (ck('ma-cfg-out-ip') && d.account?.ip) parts.push(`ip:${d.account.ip}`);
                  if (ck('ma-cfg-out-deviceid') && d.account?.sn) parts.push(`sn:${d.account.sn}`);
                  if (ck('ma-cfg-out-backend') && d.account?.backend) parts.push(`backend:${d.account.backend}`);
                  if (ck('ma-cfg-out-maxconn') && d.account?.max_connections) parts.push(`maxconn:${d.account.max_connections}`);
                  if (d.channelCount) parts.push(`${d.channelCount}ch`);
                  if (d.streamWorks) parts.push('🟢STREAM');
                  else if (d.channelCount > 0) parts.push('🔴CDN');
                  if (ck('ma-cfg-out-proxyused') && d.proxy) parts.push(`proxy:${d.proxy}`);
                  if (ck('ma-cfg-out-datefound')) parts.push(`found:${new Date().toLocaleString()}`);
                  if (ck('ma-cfg-out-genres') && d.channelCount) parts.push('genres:yes');
                  if (ck('ma-cfg-out-vod')) parts.push('vod:check');
                  outLog.textContent += '\n' + parts.join(' | ');
                  outLog.scrollTop = outLog.scrollHeight;
                }
                // Save hit to localStorage so Load Channels / Player tab can use it
                try {
                  const saved = JSON.parse(localStorage.getItem('cinevault_stalker_hits') || '[]');
                  const newHit = {
                    mac: d.mac,
                    url: d.url || document.getElementById('stalker-url')?.value || document.getElementById('ma-url')?.value || '',
                    portalUrl: d.url || '',
                    token: d.token || '',
                    expiry: d.expiry || 'Unknown',
                    channels: d.channelCount || '?',
                    status: 'hit',
                    portalType: d.portalType || 'Stalker_Portal',
                    foundAt: new Date().toISOString(),
                    lastSeen: new Date().toISOString(),
                  };
                  // Dedupe by MAC
