    function filterMaPlaylist(type) {
      if (!maPlaylistGrid || !window._maPlaylistData) return;
      maPlaylistRenderState.type = type;
      maPlaylistRenderState.query = document.getElementById('ma-playlist-search')?.value?.trim().toLowerCase() || '';
      const items = type === 'all' ? window._maPlaylistData : window._maPlaylistData.filter(i => i.type === type);
      if (items.length === 0) {
        restoreMaPlaylistPreview(type === 'all' ? 'No channels found' : 'No ' + type + ' channels found');
        return;
      }
      renderMaPlaylistChunk(true);
    }
    window.filterMaPlaylist = filterMaPlaylist;

    function playNextMaPlaylistItem(currentItem, reason = 'stream failed') {
      const items = (maPlaylistRenderState.items?.length ? maPlaylistRenderState.items : (window._maPlaylistData || []))
        .filter(i => i && i.type === 'live' && (i.url || i.cmd));
      if (!items.length) return false;
      const currentKey = String(currentItem?.id || currentItem?.cmd || currentItem?.url || currentItem?.name || '');
      let idx = items.findIndex(i => String(i.id || i.cmd || i.url || i.name || '') === currentKey);
      if (idx < 0) idx = 0;
      const next = items[idx + 1];
      if (!next) return false;
      setMaDebug('auto-skip', `${reason}; trying next channel`, next.name || '');
      toast('Skipping dead stream, trying: ' + (next.name || 'next channel'), 'info');
      setTimeout(() => playMaPlaylistItem(next), 400);
      return true;
    }

    // Global play function for onclick
    async function playMaVideo(item) {
      if (!maPlayerWrap) return;
      currentSource = 'stalker';
      window._returnToMacPortalOnClose = true;
      let rawUrl = (item.url || item.cmd || '').trim();
	        const rawCmd = (item.cmd || item.url || '').trim();
	        if (!rawUrl) return;
	      if (window._maActiveHls) {
	        try { window._maActiveHls.destroy(); } catch {}
	        window._maActiveHls = null;
	      }
	      setMaDebug('player', 'starting playback flow', rawUrl.slice(0, 48));

      maPlayerWrap.innerHTML = '';
      const closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.title = 'Close stream';
      closeBtn.textContent = '×';
      closeBtn.style.cssText = 'position:absolute;top:8px;right:8px;z-index:8;width:30px;height:30px;border-radius:4px;border:1px solid #333;background:rgba(0,0,0,0.8);color:#fff;font-size:1.1rem;cursor:pointer';
      closeBtn.addEventListener('click', () => {
        const v = maPlayerWrap.querySelector('video');
        if (v?._hls) { v._hls.destroy(); v._hls = null; }
        if (v) { try { v.pause(); } catch {} v.removeAttribute('src'); v.load?.(); }
        restoreMaPlayerIntro();
        setMaDebug('portal', 'stream closed, back to portal sidebar', '');
        const grid = document.getElementById('ma-playlist-grid');
        if (grid) grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
      const video = document.createElement('video');
      video.controls = true;
      video.autoplay = true;
      video.muted = true;
      video.playsInline = true;
      video.setAttribute('playsinline', '');
      video.setAttribute('webkit-playsinline', '');
      video.setAttribute('x5-video-player-type', 'h5');
      video.setAttribute('x5-video-player-fullscreen', 'false');
      video.style.cssText = 'width:100%;height:100%;border-radius:8px;background:#000';
      maPlayerWrap.appendChild(video);
      maPlayerWrap.appendChild(closeBtn);

      if (rawUrl.startsWith('ffmpeg ')) rawUrl = rawUrl.substring(7).trim();

      // For stalker portal /ch/ URLs, skip client-side create_link — /api/stalker-hls does it server-side
      // Only resolve non-/ch/ URLs here (e.g. direct HTTP streams that may redirect)
      const isStalkerChUrl = rawUrl.includes('localhost/ch/') || (rawUrl.includes('/ch/') && !rawUrl.includes('play_token'));
      if (!isStalkerChUrl && item.host && item.mac) {
        try {
          setMaDebug('resolve', 'resolving portal create_link', rawUrl.slice(0, 48));
          const token = window._stalkerToken || '';
          const proxyType = window._stalkerProxyType ? window._stalkerProxyType() : 'server';
          const linkType = (item.type === 'movies' || item.type === 'vod') ? 'vod' : 'itv';
          const seriesParam = item.item_type === 'episode' && item.episodeNumber ? `&series=${encodeURIComponent(item.episodeNumber)}` : '';
          const resolved = await fetch(`/api/stalker-create-link?url=${encodeURIComponent(item.host)}&mac=${encodeURIComponent(item.mac)}&cmd=${encodeURIComponent(rawCmd || rawUrl)}&token=${encodeURIComponent(token)}&proxy=${encodeURIComponent(proxyType)}&linkType=${linkType}${seriesParam}`, {
            signal: AbortSignal.timeout(15000)
          }).then(r => r.json());
          if (resolved.streamUrl) {
            rawUrl = resolved.streamUrl.trim();
            if (resolved.token) { window._stalkerToken = resolved.token; setMaDebug('resolve', 'token updated from create_link', resolved.token.substring(0,16)+'...'); }
            if (maVideoUrlEl) maVideoUrlEl.textContent = rawUrl;
            setMaDebug('resolve', 'create_link resolved', rawUrl.slice(0, 48));
          }
        } catch {
          setMaDebug('resolve-error', 'create_link resolution failed', rawUrl.slice(0, 48));
        }
      }

      const isMpegTsStream = rawUrl.includes('play_token') || rawUrl.includes('/ch/');
      const isHlsLike = !isMpegTsStream && (rawUrl.includes('.m3u8') || rawUrl.includes('m3u8') || rawUrl.includes('.ts'));

      // MPEG-TS / stalker portal streams → use server-side HLS transcode
      if (isMpegTsStream && item.host && item.mac) {
        const linkType = (item.type === 'movies' || item.type === 'vod' || item.item_type === 'episode') ? 'vod' : 'itv';
        const seriesParam = item.item_type === 'episode' && item.episodeNumber ? `&series=${encodeURIComponent(item.episodeNumber)}` : '';
        const hlsUrl = `/api/stalker-hls?url=${encodeURIComponent(item.host)}&mac=${encodeURIComponent(item.mac)}&cmd=${encodeURIComponent(rawCmd || rawUrl)}&linkType=${linkType}${seriesParam}`;
        setMaDebug('hls-transcode', 'requesting server-side HLS transcode', hlsUrl.slice(0, 80));
        if (typeof Hls !== 'undefined' && Hls.isSupported()) {
          let restartCount = 0;
          const buildPortalHls = () => new Hls(makeStableHlsConfig());
          const attachPortalHls = (src, usingTranscode = false) => {
	            const hls = buildPortalHls();
	            video._hls = hls;
	            window._maActiveHls = hls;
	            hls.loadSource(src);
            hls.attachMedia(video);
            hls.on(Hls.Events.MANIFEST_PARSED, () => {
              setMaDebug('playing', 'transcoded manifest parsed, playing', src.slice(0, 60));
              forceBestHlsQuality(hls, item.name || 'MacAttack');
              video.play().catch(() => {});
            });
            hls.on(Hls.Events.ERROR, (_, data) => {
              if (!data?.fatal) {
                setMaDebug('hls-warn', data.details || 'non-fatal hls error', '');
                return;
              }
              setMaDebug('hls-error', data.details || 'fatal hls error', src.slice(0, 60));
              if (!usingTranscode && (data.details === 'bufferIncompatibleCodecsError' || data.details === 'fragParsingError' || /codec|parsing/i.test(data.details || ''))) {
                try { hls.destroy(); } catch {}
                video._hls = null;
                const transcodeUrl = `${hlsUrl}${hlsUrl.includes('?') ? '&' : '?'}mode=transcode&codec_retry=${Date.now()}`;
                setMaDebug('hls-transcode', 'codec not browser playable, retrying transcode', '');
                setTimeout(() => attachPortalHls(transcodeUrl, true), 600);
                return;
              }
              // Try recovery BEFORE destroying — destroy makes hls unusable
              if (data.type === Hls.ErrorTypes.NETWORK_ERROR) {
                try {
                  hls.startLoad();
                  setMaDebug('hls-recover', 'network error, restarting HLS load', '');
                  return;
                } catch {}
              }
              if (data.type === Hls.ErrorTypes.MEDIA_ERROR) {
                try {
                  hls.recoverMediaError();
                  setMaDebug('hls-recover', 'media error, recovering player', '');
                  return;
                } catch {}
              }
              // All recovery failed — destroy and retry with fresh session
              try { hls.destroy(); } catch {}
              video._hls = null;
              if (restartCount < 3) {
                restartCount++;
                const retryUrl = `${hlsUrl}${hlsUrl.includes('?') ? '&' : '?'}retry=${Date.now()}-${restartCount}`;
                setMaDebug('hls-retry', `refreshing stream session ${restartCount}/3`, '');
                setTimeout(() => attachPortalHls(retryUrl, usingTranscode), 1200);
              } else {
                if (!playNextMaPlaylistItem(item, 'stream failed after retries')) {
                  toast('⚠️ Stream stalled after retries — try the next working channel', 'error');
                }
              }
            });
          };
          attachPortalHls(hlsUrl);
        } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
          // Safari native HLS
          video.src = hlsUrl;
          video.play().catch(() => {});
        } else {
          toast('⚠️ HLS.js not supported in this browser', 'error');
        }
      } else if (isHlsLike && typeof Hls !== 'undefined' && Hls.isSupported()) {
        const proxiedUrl = `/api/hls-proxy?url=${encodeURIComponent(rawUrl)}`;
        setMaDebug('hls', 'attaching HLS.js', proxiedUrl.slice(0, 48));
	        const hls = new Hls(makeStableHlsConfig());
	        video._hls = hls;
	        window._maActiveHls = hls;
	        hls.loadSource(proxiedUrl);
        hls.attachMedia(video);
        hls.on(Hls.Events.MANIFEST_PARSED, () => {
          setMaDebug('playing', 'manifest parsed', proxiedUrl.slice(0, 48));
          forceBestHlsQuality(hls, item.name || 'MacAttack');
          video.play().catch(() => {});
        });
        hls.on(Hls.Events.ERROR, (_, data) => {
          if (data?.fatal) {
            switch(data.type) {
              case Hls.ErrorTypes.NETWORK_ERROR:
                setMaDebug('hls-retry', 'network error — retrying', proxiedUrl.slice(0, 48));
                hls.startLoad();
                break;
              case Hls.ErrorTypes.MEDIA_ERROR:
                setMaDebug('hls-retry', 'media error — recovering', proxiedUrl.slice(0, 48));
                hls.recoverMediaError();
                break;
              default:
                setMaDebug('hls-error', data.details || 'fatal hls error', proxiedUrl.slice(0, 48));
                toast('⚠️ Stream format not supported by this source', 'error');
                break;
            }
          }
        });
      } else {
        const directUrl = isMpegTsStream
          ? `/api/stalker-stream?url=${encodeURIComponent(rawUrl)}&mac=${encodeURIComponent(item.mac || '')}&portal=${encodeURIComponent(item.host || '')}&token=${encodeURIComponent(window._stalkerToken || '')}`
          : rawUrl;
        setMaDebug('direct', 'loading direct video source', directUrl.slice(0, 48));
        video.src = directUrl;
        video.play().catch(() => {});
      }

      video.addEventListener('error', () => {
        setMaDebug('video-error', `media error code ${video.error?.code || 'unknown'}`, '');
        toast('⚠️ No video with supported format or MIME type found', 'error');
      }, { once: true });
      video.addEventListener('playing', () => {
        setMaDebug('playing', 'video is rendering', '');
      }, { once: true });
    }

    function playMaPlaylistItem(item) {
      if (!item) return;
      const playerTab = document.querySelector('.ma-tab-btn[data-ma-tab="player"]');
      if (playerTab) playerTab.click();
      // VOD category click — load movies in that category
      if (item.vodCategoryId && (item.url === 'vod-category' || item.cmd === 'vod-category')) {
        loadVodCategory(item.vodCategoryId, item.name);
        return;
      }
      if (item.seriesCategoryId && (item.url === 'series-category' || item.cmd === 'series-category')) {
        loadSeriesCategory(item.seriesCategoryId, item.name);
        return;
      }
      // Season item — load episodes for this season
      if (item.item_type === 'season' && item.seriesId) {
        loadSeriesEpisodes(item);
        return;
      }
      if (item.type === 'series' && item.item_type !== 'episode' && item.id && !(item.cmd || item.url)) {
        loadSeriesEpisodes(item);
        return;
      }
      if (!item.url && !item.cmd) return;
      if (maVideoUrlEl) maVideoUrlEl.textContent = item.url || item.cmd;
      playMaVideo(item);
      window._maLastPlayedItem = item;
      // Show VLC top-bar button
      const vlcBtn = document.getElementById('ma-vlc-launch-btn');
      if (vlcBtn) vlcBtn.style.display = 'block';
      toast('▶ Playing: ' + (item.name || 'Channel'), 'success');
    }

    // ── VLC Launch for MacAttack Player Tab ──
    // Per-device: each click spawns its own VLC process with resolved stream URL
    // No CPU/GPU sharing — VLC handles decode on its own process
    async function launchMaVlc(item, btn) {
      if (!item) return;
      // Switch to Player tab first (same as row click does)
      const playerTab = document.querySelector('.ma-tab-btn[data-ma-tab="player"]');
      if (playerTab) playerTab.click();
      // Update video URL bar
      if (maVideoUrlEl) maVideoUrlEl.textContent = item.url || item.cmd || '';
      const origText = btn ? btn.textContent : '';
      if (btn) { btn.textContent = '⏳'; btn.style.opacity = '1'; }

      try {
        let rawUrl = (item.url || item.cmd || '').trim();
        const rawCmd = (item.cmd || item.url || '').trim();

        // Stalker portal channel — resolve via create_link, then launch VLC with relay
        if (item.host && item.mac && (rawUrl.includes('/ch/') || rawUrl.includes('play_token') || item.id)) {
          const channelId = item.id || item.ch_id;
          if (channelId) {
            const r = await fetch(`/api/vlc-channel/${encodeURIComponent(channelId)}?url=${encodeURIComponent(item.host)}&mac=${encodeURIComponent(item.mac)}`);
            const d = await r.json();
            if (d.success) {
              toast(`🎯 VLC launched: ${d.channel || item.name} (PID ${d.pid})`, 'success');
              if (btn) { btn.textContent = '🎯'; btn.style.opacity = '0.4'; }
              return;
            }
            // Fallback — try direct URL below
            if (d.relayId) {
              // relay already created but VLC spawn failed? Try vlc-play
            }
          }
        }

        // Direct stream URL — resolve if stalker, then vlc-play
        if (item.host && item.mac && !rawUrl.startsWith('http://127.0.0.1') && !rawUrl.startsWith('http://localhost')) {
          try {
            const token = window._stalkerToken || '';
            const proxyType = window._stalkerProxyType ? window._stalkerProxyType() : 'server';
            const linkType = (item.type === 'movies' || item.type === 'vod') ? 'vod' : 'itv';
            const resolved = await fetch(`/api/stalker-create-link?url=${encodeURIComponent(item.host)}&mac=${encodeURIComponent(item.mac)}&cmd=${encodeURIComponent(rawCmd || rawUrl)}&token=${encodeURIComponent(token)}&proxy=${encodeURIComponent(proxyType)}&linkType=${linkType}`).then(r => r.json());
            if (resolved.streamUrl) {
              rawUrl = resolved.streamUrl;
              if (resolved.token) window._stalkerToken = resolved.token;
            }
          } catch { /* fallback to raw */ }
        }

        // Final: launch VLC with resolved URL via vlc-play
        const playUrl = `/api/vlc-play?url=${encodeURIComponent(rawUrl)}`;
        const r = await fetch(playUrl);
        const d = await r.json();
        if (d.success) {
          toast(`🎯 VLC launched: ${item.name || 'Channel'} (PID ${d.pid})`, 'success');
        } else {
          toast('⚠️ VLC launch failed: ' + (d.error || 'unknown'), 'error');
        }
      } catch (err) {
        toast('⚠️ VLC error: ' + err.message, 'error');
      }
      if (btn) { btn.textContent = '🎯'; btn.style.opacity = '0.4'; }
    }

    window.playMaChannel = function(idx, type) {
      const items = maPlaylistRenderState.type === type && maPlaylistRenderState.items?.length
        ? maPlaylistRenderState.items
        : (type === 'all' ? window._maPlaylistData : window._maPlaylistData.filter(i => i.type === type));
      playMaPlaylistItem(items[idx]);
    };

    // Load VOD category movies — fetches /api/stalker-vod-list and displays results
    async function loadVodCategory(categoryId, categoryName) {
      if (!maPlaylistGrid) return;
      const host = window._maPortalHost || (maHostInput ? maHostInput.value.trim() : '');
      const mac = window._maPortalMac || (maMacInput ? maMacInput.value.trim() : '');
      if (!host || !mac) { toast('⚠️ Portal host/MAC not set', 'error'); return; }
      maPlaylistGrid.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted)">⏳ Loading movies...</div>';
      setMaDebug('vod', 'loading VOD category ' + categoryId, host);
      try {
        const res = await fetch(`/api/stalker-vod-list?url=${encodeURIComponent(host)}&mac=${encodeURIComponent(mac)}&category_id=${encodeURIComponent(categoryId)}`);
        const data = await res.json();
        if (data.movies && data.movies.length > 0) {
          // Add movies to playlist data with proper VOD type
          const newMovies = data.movies.map(m => ({
            ...m,
            type: 'movies',
            host, mac,
            vodCategoryId: categoryId,
          }));
          // Replace VOD category items with actual movies
          window._maPlaylistData = (window._maPlaylistData || []).filter(i => i.vodCategoryId !== categoryId || i.url === 'vod-category');
          // Remove the category placeholder
          window._maPlaylistData = window._maPlaylistData.filter(i => !(i.id === 'vod-cat-' + categoryId));
          // Add actual movies
          window._maPlaylistData.push(...newMovies);
          filterMaPlaylist('movies');
          setMaDebug('vod', `loaded ${data.movies.length} movies in category`, categoryName || categoryId);
          toast('🎬 Loaded ' + data.movies.length + ' movies', 'success');
        } else {
          maPlaylistGrid.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted)">No movies found in this category</div>';
        }
      } catch (e) {
        maPlaylistGrid.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted)">Error loading movies</div>';
        setMaDebug('vod-error', e.message, host);
      }
    }

    async function loadSeriesCategory(categoryId, categoryName) {
      if (!maPlaylistGrid) return;
      const host = window._maPortalHost || (maHostInput ? maHostInput.value.trim() : '');
      const mac = window._maPortalMac || (maMacInput ? maMacInput.value.trim() : '');
      if (!host || !mac) { toast('⚠️ Portal host/MAC not set', 'error'); return; }
      maPlaylistGrid.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--text-muted)">⏳ Loading series...</div>';
