  // 🤝 HANDSHAKE ONLY — just get a token, don't load channels
  async function handshakeLiveTV() {
    const urlEl = document.getElementById('livetv-portal-url');
    const macEl = document.getElementById('livetv-mac');
    const statusEl = document.getElementById('livetv-connect-status');

    const portalUrl = urlEl?.value?.trim();
    const mac = macEl?.value?.trim() || '00:1A:79:A3:96:BF';

    if (!portalUrl) {
      if (statusEl) statusEl.innerHTML = '<span style="color:#e50914">❌ Enter a portal URL</span>';
      return;
    }

    if (statusEl) statusEl.innerHTML = '🤝 Handshaking...';

    // Use StalkerScanner handshake or direct fetch
    try {
      if (typeof StalkerScanner !== 'undefined' && StalkerScanner.connectToPortal) {
        // Just detect + handshake, skip channel load
        const detection = await StalkerScanner.detectPortalType?.(portalUrl) || { endpoint: 'stalker_portal/server', type: 'Unknown', version: '?' };
        const session = await StalkerScanner.handshake?.(portalUrl, detection.endpoint || 'stalker_portal/server', mac);

        if (session && session.token) {
          setSkullEyes('green');
          if (statusEl) statusEl.innerHTML = `<span style="color:#00ff00">🤝 Handshake OK! Token: ${esc(session.token.substring(0, 12))}... | Type: ${esc(detection.type)} v${esc(detection.version)}</span>`;
          playHitSound();
        } else {
          setSkullEyes('red');
          if (statusEl) statusEl.innerHTML = '<span style="color:#e50914">❌ Handshake failed — no token received</span>';
        }
      } else {
        // Fallback: test via server endpoint
        const resp = await fetch(`/api/stalker-handshake?url=${encodeURIComponent(portalUrl)}&mac=${encodeURIComponent(mac)}&proxy=${encodeURIComponent(window._stalkerProxyType())}`, {
          signal: AbortSignal.timeout(10000)
        });
        const data = await resp.json();
        const token = data?.token;
        if (token) {
          window._stalkerToken = token;
          setSkullEyes('green');
          playHitSound();
          if (statusEl) statusEl.innerHTML = `<span style="color:#00ff00">🤝 Token received: ${esc(token.substring(0, 12))}...</span>`;
        } else {
          setSkullEyes('red');
          if (statusEl) statusEl.innerHTML = `<span style="color:#e50914">❌ No token. Response: ${esc(JSON.stringify(data).substring(0, 100))}</span>`;
        }
      }
    } catch (err) {
      setSkullEyes('red');
      if (statusEl) statusEl.innerHTML = `<span style="color:#e50914">❌ Handshake error: ${esc(err.message)}</span>`;
    }
  }

  // Show channels in the Playlist tab
  function showPlaylistChannels(portal) {
    // Switch to Live sub-tab in Player tab
    const liveTab = document.querySelector('[data-ma-playlist="all"]') || document.querySelector('[data-ma-playlist="live"]');
    if (liveTab) liveTab.click();

    // Store channels for the MacAttack Player playlist system
    if (portal.channels && portal.channels.length) {
      window._maPlaylistData = typeof window.normalizeMaPlaylistItems === 'function'
        ? window.normalizeMaPlaylistItems(portal.channels, portal.url || '', portal.mac || '')
        : portal.channels.map(ch => ({
            name: ch.name || 'Channel',
            url: ch.url || ch.cmd || '',
            cmd: ch.cmd || '',
            type: 'live',
            host: portal.url || '',
            mac: portal.mac || ''
          }));
      // Activate Live tab and render
      if (typeof window.filterMaPlaylist === 'function') {
        window.filterMaPlaylist('all');
      }
    }

    const statusEl = document.getElementById('ma-debug-phase') || document.getElementById('livetv-playlist-status');

    if (statusEl) statusEl.textContent = `✅ ${portal.channelCount || portal.channels?.length || 0} channels`;

    const gridEl = document.getElementById('ma-playlist-grid') || document.getElementById('livetv-playlist-grid');

    if (!portal.channels || !portal.channels.length) {
      if (gridEl) gridEl.innerHTML = '<p style="color:#888;text-align:center;padding:20px">No channels found</p>';
      return;
    }

    if (gridEl && gridEl.id === 'ma-playlist-grid') return;

    // Group by genreName (actual genre label like "United States"), not genre ID
    const byGroup = {};
    for (const ch of portal.channels) {
      const group = ch.genreName || ch.group || 'Other';
      if (!byGroup[group]) byGroup[group] = [];
      byGroup[group].push(ch);
    }

    // Sort groups: US genres first, then alphabetical
    const isUSGroup = /(^|[^a-z0-9])(united\s*states|usa|u\.s\.a\.?|u\.s\.|us|american)([^a-z0-9]|$)/i;
    const sortedGroups = Object.entries(byGroup).sort((a, b) => {
      const aUS = isUSGroup.test(a[0]) ? 0 : 1;
      const bUS = isUSGroup.test(b[0]) ? 0 : 1;
      if (aUS !== bUS) return aUS - bUS;
      return a[0].localeCompare(b[0]);
    });

    let html = '';
    for (const [group, channels] of sortedGroups) {
      html += `<div class="playlist-group">
        <h4 class="playlist-group-title">${esc(group)} (${esc(channels.length)})</h4>
        <div class="playlist-channels">`;
      for (const ch of channels) {
        const logo = ch.logo || '';
        // ALL channels are playable — localhost URLs get resolved on-demand via create_link
        html += `<div class="playlist-channel has-stream" data-url="${esc(ch.url || '')}" data-cmd="${esc(ch.cmd || '')}" data-portal="${esc(portal.url)}" data-mac="${esc(portal.mac)}" data-name="${esc(ch.name || '')}" data-id="${esc(ch.id || '')}">
          ${logo ? `<img src="${esc(logo)}" class="playlist-ch-logo" onerror="this.style.display='none'" alt="">` : '<span class="playlist-ch-icon">📺</span>'}
          <span class="playlist-ch-name">${esc(ch.name || 'Channel')}</span>
          ${ch.number ? `<span class="playlist-ch-num">#${esc(ch.number)}</span>` : ''}
          ${ch.id ? `<span style="font-size:0.6rem;color:#555;margin-left:3px">ID:${esc(ch.id)}</span>` : ''}
          <span style="font-size:0.6rem;background:rgba(229,9,20,0.2);color:#ff6666;padding:1px 4px;border-radius:3px;margin-left:3px">${esc(group)}</span>
          <span class="playlist-live-dot"></span>
        </div>`;
      }
      html += '</div></div>';
    }
    gridEl.innerHTML = html;

    // Click handler: play channel — resolves localhost URLs via create_link
    gridEl.querySelectorAll('.playlist-channel.has-stream').forEach(el => {
      el.addEventListener('click', () => {
        const name = el.dataset.name;
        const cmd = el.dataset.cmd;
        const portalUrl = el.dataset.portal;
        const mac = el.dataset.mac;
        playStalkerChannel(portalUrl, mac, name);
      });
    });
  }

