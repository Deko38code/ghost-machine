  function formatPlayerClock(seconds) {
    const safe = Number.isFinite(seconds) && seconds > 0 ? Math.floor(seconds) : 0;
    const h = Math.floor(safe / 3600);
    const m = Math.floor((safe % 3600) / 60);
    const s = String(safe % 60).padStart(2, '0');
    return h ? `${h}:${String(m).padStart(2, '0')}:${s}` : `${m}:${s}`;
  }

  function normalizeWatchlistText(value) {
    return String(value || '').trim().toLowerCase();
  }

  function stopEmbedTimeDisplay() {
    if (embedTimeTimer) {
      clearInterval(embedTimeTimer);
      embedTimeTimer = null;
    }
    embedStartedAt = null;
  }

  function setPlayerTimePending() {
    stopEmbedTimeDisplay();
    if (playerProgress) playerProgress.style.width = '0%';
    if (playerTime) playerTime.textContent = 'Loading...';
  }

  function startEmbedTimeDisplay() {
    stopEmbedTimeDisplay();
    if (playerProgress) playerProgress.style.width = '100%';
    if (!playerTime) return;
    embedStartedAt = Date.now();
    const update = () => {
      const elapsed = Math.max(0, Math.floor((Date.now() - embedStartedAt) / 1000) + embedSeekOffset);
      playerTime.textContent = `${formatPlayerClock(elapsed)} / --:--`;
    };
    update();
    embedTimeTimer = setInterval(update, 5000);
  }

  function getEmbedElapsedSeconds() {
    const running = embedStartedAt ? Math.floor((Date.now() - embedStartedAt) / 1000) : 0;
    return Math.max(0, running + embedSeekOffset);
  }

  function updateNativePlayerTime(videoEl) {
    if (!videoEl || !playerTime) return;
    const current = Number.isFinite(videoEl.currentTime) ? videoEl.currentTime : 0;
    const duration = Number.isFinite(videoEl.duration) && videoEl.duration > 0 ? videoEl.duration : 0;
    if (playerProgress && duration) playerProgress.style.width = `${Math.min(100, Math.max(0, (current / duration) * 100))}%`;
    playerTime.textContent = duration ? `${formatPlayerClock(current)} / ${formatPlayerClock(duration)}` : `${formatPlayerClock(current)} / --:--`;
  }

  function setLiveTimeDisplay(videoEl) {
    stopEmbedTimeDisplay();
    if (playerProgress) playerProgress.style.width = '100%';
    if (!playerTime) return;
    const update = () => {
      const seconds = videoEl && Number.isFinite(videoEl.currentTime) ? Math.floor(videoEl.currentTime) : 0;
      if (seconds > 0) {
        const m = Math.floor(seconds / 60);
        const s = String(seconds % 60).padStart(2, '0');
        playerTime.textContent = `${m}:${s} / LIVE`;
      } else {
        playerTime.textContent = 'LIVE';
      }
    };
    update();
    if (videoEl) videoEl.addEventListener('timeupdate', () => {
      update();
      updateNativePlayerTime(videoEl);
    }, true);
  }

  function postPlayerCommand(payloads) {
    if (!playerElement || !playerElement.contentWindow) return false;
    const list = Array.isArray(payloads) ? payloads : [payloads];
    list.forEach(payload => {
      try { playerElement.contentWindow.postMessage(payload, '*'); } catch {}
    });
    return true;
  }

  function sendPlayerKey(key) {
    if (!playerElement || !playerElement.contentWindow) return;
    const codeMap = { ArrowLeft: 37, ArrowRight: 39, Space: 32, KeyK: 75 };
    const keyCode = codeMap[key] || 0;
    ['keydown', 'keyup'].forEach(type => {
      try {
        playerElement.contentWindow.postMessage({ type, key, code: key, keyCode, which: keyCode }, '*');
      } catch {}
    });
  }

  function seekEmbedPlayer(delta) {
    const target = Math.max(0, getEmbedElapsedSeconds() + delta);
    embedSeekOffset = Math.max(0, embedSeekOffset + delta);
    postPlayerCommand([
      { type: 'seek', seconds: delta, time: target },
      { type: 'player:seek', seconds: delta, time: target },
      { method: 'seek', seconds: delta, time: target },
      { method: 'seekTo', seconds: target },
      { event: 'command', method: 'seekTo', seconds: target },
      { event: 'command', method: 'setCurrentTime', value: target },
      { command: 'seek', value: target },
      { command: delta > 0 ? 'seekForward' : 'seekBackward', value: Math.abs(delta) },
      { action: 'seek', value: target },
      { func: 'seekTo', args: [target] }
    ]);
    try { playerElement.contentWindow.focus(); } catch {}
    const key = delta > 0 ? 'ArrowRight' : 'ArrowLeft';
    const presses = Math.max(1, Math.min(8, Math.round(Math.abs(delta) / 10)));
    for (let i = 0; i < presses; i++) sendPlayerKey(key);
    if (playerTime) playerTime.textContent = `${formatPlayerClock(target)} / --:--`;
  }

  function seekPlayerBy(seconds) {
    const delta = Number(seconds) || 0;
    if (!delta) return;
    if (playerElement && playerElement.tagName === 'VIDEO') {
      try {
        playerElement.currentTime = Math.max(0, playerElement.currentTime + delta);
        updateNativePlayerTime(playerElement);
        return;
      } catch {}
    }
    if (playerElement && playerElement.tagName === 'IFRAME') seekEmbedPlayer(delta);
    showToast(delta > 0 ? `Skipped +${Math.abs(delta)}s` : `Skipped -${Math.abs(delta)}s`);
  }

  function seekPlayerToPercent(percent) {
    const pct = Math.max(0, Math.min(1, Number(percent) || 0));
    if (playerElement && playerElement.tagName === 'VIDEO') {
      const duration = Number.isFinite(playerElement.duration) && playerElement.duration > 0 ? playerElement.duration : 0;
      if (duration) {
        playerElement.currentTime = duration * pct;
        updateNativePlayerTime(playerElement);
        return;
      }
    }
    const target = Math.round(7200 * pct);
    const current = getEmbedElapsedSeconds();
    seekEmbedPlayer(target - current);
    if (playerProgress) playerProgress.style.width = `${pct * 100}%`;
  }

  function setPlayerVolume(value) {
    const volume = Math.max(0, Math.min(100, Number(value) || 0));
    if (playerVolSlider) playerVolSlider.value = String(volume);
    if (volume > 0) lastVolume = volume;
    if (playerVolBtn) {
      playerVolBtn.textContent = volume === 0 ? '🔇' : volume < 50 ? '🔉' : '🔊';
      playerVolBtn.title = volume === 0 ? 'Unmute' : 'Mute';
    }
    if (playerElement && playerElement.tagName === 'VIDEO') {
      try {
        playerElement.volume = volume / 100;
        playerElement.muted = volume === 0;
      } catch {}
    }
    // For iframe embeds: focus iframe + send postMessage volume commands
    // Many embeds (vidsrc, vidsrcpm, 2embed, cloudnestra) start muted due to
    // browser autoplay policy. Clicking unmute must give the iframe user-gesture
    // context AND send multiple postMessage formats to reach the internal player.
    if (playerElement && playerElement.tagName === 'IFRAME') {
      try {
        // Focus iframe — gives browser user-gesture context for audio unlock
        playerElement.focus();
        if (playerElement.contentWindow) {
          const v = volume / 100;
          // Standard postMessage formats most embeds recognize
          playerElement.contentWindow.postMessage({ type: 'volume', value: v }, '*');
          playerElement.contentWindow.postMessage({ method: 'setVolume', value: v }, '*');
          playerElement.contentWindow.postMessage({ event: 'command', method: 'setVolume', value: volume }, '*');
          playerElement.contentWindow.postMessage({ command: 'setVolume', value: volume }, '*');
          playerElement.contentWindow.postMessage({ type: 'setVolume', value: volume }, '*');
          playerElement.contentWindow.postMessage({ method: 'volume', value: v }, '*');
          // Explicit unmute/mute commands (vidsrc/cloudnestra formats)
          if (volume > 0) {
            playerElement.contentWindow.postMessage({ type: 'unmute' }, '*');
            playerElement.contentWindow.postMessage({ method: 'unmute' }, '*');
            playerElement.contentWindow.postMessage({ event: 'command', method: 'unmute' }, '*');
            playerElement.contentWindow.postMessage({ command: 'unmute' }, '*');
          } else {
            playerElement.contentWindow.postMessage({ type: 'mute' }, '*');
            playerElement.contentWindow.postMessage({ method: 'mute' }, '*');
          }
          // Some players use a 'pcommand' format
          playerElement.contentWindow.postMessage({ pcommand: volume > 0 ? 'unmute' : 'mute' }, '*');
        }
      } catch {}
    }
    postPlayerCommand([
      { type: 'volume', value: volume / 100 },
      { method: 'volume', value: volume / 100 },
      { event: 'command', method: 'setVolume', value: volume },
      { command: 'setVolume', value: volume }
    ]);
  }

  function nudgeVolume(delta) {
    const current = playerVolSlider ? Number(playerVolSlider.value || 0) : lastVolume;
    setPlayerVolume(current + delta);
  }

  function showPlayerChrome() {
