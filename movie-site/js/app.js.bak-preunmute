      navigator.clipboard.writeText(_serveoUrl).then(() => {
        if (typeof toast === 'function') toast('Copied: ' + _serveoUrl);
      });
    }
  };
  // Poll slowly and only when the tunnel status UI exists.
  if (document.getElementById('bore-url-text')) refreshServeoTunnel();
  if (!serveoTunnelPollId) {
    serveoTunnelPollId = setInterval(() => {
      if (document.getElementById('bore-url-text')) refreshServeoTunnel();
