    `;
    // Insert into player overlay
    const overlay = document.getElementById('player-overlay');
    if (overlay) overlay.appendChild(bar);

    // VLC button — resolve real CDN URL then open in VLC
    const vlcBtn = document.getElementById('vlc-open-btn');
    if (vlcBtn) {
      vlcBtn.addEventListener('click', async () => {
        vlcBtn.textContent = '⏳';
        vlcBtn.disabled = true;
        try {
          const channelId = window._stalkerLastChannelId || '';
          if (!channelId) {
            toast('Select a channel first', 'error');
            return;
          }
          // New optimized endpoint — server does full handshake + cache + prefetch
          const r = await fetch(`/api/vlc-channel/${encodeURIComponent(channelId)}`);
          const d = await r.json();
          if (d.success) {
            toast(`${d.channel || 'Channel'} → VLC launched`, 'success');
            // Update now-playing display
            const np = document.getElementById('vlc-now-playing');
            if (np) np.textContent = `▶ ${d.channel || 'Channel'}`;
            // Highlight active channel row, remove previous
            document.querySelectorAll('.livetv-portal-channel.vlc-active').forEach(el => el.classList.remove('vlc-active'));
            const activeRow = document.querySelector(`[data-channel-id="${channelId}"]`);
            if (activeRow) activeRow.classList.add('vlc-active');
          } else {
            toast(d.error || 'VLC launch failed', 'error');
          }
        } catch(e) {
          toast('VLC launch failed: ' + e.message, 'error');
        }
        vlcBtn.textContent = '▶ VLC';
        vlcBtn.disabled = false;
      });
    }

    // ── Keyboard shortcuts for VLC channel switching ──
    // ↑/↓ = prev/next channel, Space/k = kill VLC, v = launch VLC for current channel
    window._vlcKeyHandler = (e) => {
      // Only when player overlay is visible and no input focused
      const overlay = document.getElementById('player-overlay');
      if (!overlay || overlay.style.display === 'none') return;
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;

      if (e.key === 'ArrowUp' || e.key === 'ArrowDown') {
        e.preventDefault();
        const rows = Array.from(document.querySelectorAll('[data-channel-idx]'));
        if (!rows.length) return;

        // Find current active or last-clicked row
        const activeRow = document.querySelector('.livetv-portal-channel.vlc-active') || document.querySelector('[data-channel-idx]');
        const activeIdx = activeRow ? parseInt(activeRow.getAttribute('data-channel-idx'), 10) : 0;
        const nextIdx = e.key === 'ArrowDown'
          ? Math.min(activeIdx + 1, rows.length - 1)
          : Math.max(activeIdx - 1, 0);

        // Click the next channel row to switch
        const nextRow = rows.find(r => parseInt(r.getAttribute('data-channel-idx'), 10) === nextIdx);
        if (nextRow) {
          nextRow.click();
          nextRow.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
      } else if (e.key === ' ' || e.key === 'k') {
        e.preventDefault();
        fetch('/api/vlc-kill', { method: 'POST' });
        const np = document.getElementById('vlc-now-playing');
        if (np) np.textContent = '⏹ Stopped';
      } else if (e.key === 'v' || e.key === 'V') {
        e.preventDefault();
        const vlcBtn = document.getElementById('vlc-open-btn');
        if (vlcBtn) vlcBtn.click();
      }
    };
    document.addEventListener('keydown', window._vlcKeyHandler);

    // Clean up on player close
    const origClose = playerClose?.onclick;
    if (playerClose) {
      playerClose.onclick = () => {
        const infoBar = document.getElementById('stalker-player-info');
        if (infoBar) infoBar.remove();
        // Remove keyboard handler
        if (window._vlcKeyHandler) {
          document.removeEventListener('keydown', window._vlcKeyHandler);
          window._vlcKeyHandler = null;
        }
        if (origClose) origClose();
      };
    }
  }

