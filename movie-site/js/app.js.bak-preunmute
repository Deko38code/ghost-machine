  // ── Rebuild alpha quick-jump bar from any channel list ──
  function rebuildAlphaBar(channels) {
    const alphaBar = document.getElementById('livetv-alpha-bar');
    if (!alphaBar || !channels || !channels.length) {
      if (alphaBar) alphaBar.innerHTML = '';
      return;
    }
    const letterMap = {};
    channels.forEach(ch => {
      const name = (ch.name || ch.title || '').trim();
      if (name) {
        const letter = name[0].toUpperCase();
        if (/[A-Z]/.test(letter)) {
          if (!letterMap[letter]) letterMap[letter] = true;
        }
      }
