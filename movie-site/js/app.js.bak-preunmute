    if (playerPlayBtn) { playerPlayBtn.textContent = '⏸'; playerPlayBtn.title = 'Pause'; }
    if (playerTitle) playerTitle.textContent = movie.title || movie.name || 'Now Playing';
    const tabs = document.getElementById('player-source-tabs');
    if (tabs) tabs.style.display = 'none';
    const urlBar = document.getElementById('direct-url-bar');
    if (urlBar) urlBar.style.display = 'none';
    playerVideoWrap.innerHTML = '';
    setPlayerTimePending();
    showPlayerSpinner('Loading video...');
    const iframe = preparePlayerIframe(document.createElement('iframe'));
    iframe.src = embedUrl;
    iframe.allow = 'autoplay; fullscreen; encrypted-media; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.setAttribute('referrerpolicy', 'no-referrer');
    iframe.style.cssText = 'width:100%;height:100%;border:none;outline:none;background:#000;';
    iframe.onload = () => {
      hidePlayerSpinner();
      setSkullConnected(movie.title || movie.name || 'Video');
      startEmbedTimeDisplay();
    };
    iframe.onerror = () => {
      hidePlayerSpinner();
      setSkullEyes('red');
      showToast('Video failed to load', 'error');
    };
    playerVideoWrap.appendChild(iframe);
    playerElement = iframe;
    setPlayerVolume(playerVolSlider ? playerVolSlider.value : lastVolume);
    startControlsAutoHide();
  }

